                    </div>

                    <div class="agent-badges">
                        <span class="wl-badge badge-purple">CASCADE PIPELINE</span>
                        <span class="wl-badge badge-green">FitZone n8n (Frozen)</span>
                        <span class="wl-badge badge-blue">Gemini TTS</span>
                        <span class="wl-badge badge-purple">Multi-Tenant Context</span>
                        <span class="wl-badge">v1.1.0-prod</span>
                    </div>

                    <div class="agent-metric-strip">
                        <div class="agent-metric-item">
                            <div class="agent-metric-val">10</div>
                            <div class="agent-metric-lbl">Tools</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val">3</div>
                            <div class="agent-metric-lbl">Skills</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val text-success">100%</div>
                            <div class="agent-metric-lbl">Parity</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val text-info">{{ agent_groups.get('wasid-customer-master', [])|length }}</div>
                            <div class="agent-metric-lbl">Dispatches</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1" onclick="openSpecDrawer('wasid-customer-master')">
                        <i class="bi bi-layers"></i>
                        <span>Inspect 13 Dimensions</span>
                    </button>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" onclick="populateDispatchModal('wasid-customer-master')">
                            <i class="bi bi-play-circle"></i>
                            <span>Test Dispatch</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" onclick="prepareOutboundCall('wasid-customer-master')">
                            <i class="bi bi-telephone-outbound"></i>
                            <span>Call</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Voice Routing Matrix Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <div>
                <h5 class="wl-card-title">
                    <i class="bi bi-diagram-3 text-success"></i>
                    Voice Routing Matrix (SIP Telephony & Agent Dispatch Chain)
                </h5>
                <div class="text-secondary small mt-1">
                    LiveKit SIP Architecture: <strong class="text-success">1 Call = 1 Unique LiveKit Room</strong> | Automatic Agent Dispatch
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-1">
                    <i class="bi bi-check-circle me-1"></i> Zero Drift Guaranteed
                </span>
                <a href="/sip-inbound" class="btn btn-sm btn-outline-info" style="font-size:0.75rem;">
                    <i class="bi bi-gear"></i> Full Telephony Admin
                </a>
            </div>
        </div>

        <!-- Visual Routing Pipeline Diagram -->
        <div class="routing-pipeline-diagram">
            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-telephone text-primary"></i>
                    <span>PSTN Ingress</span>
                </div>
                <div class="pipeline-step-sub">Vobiz DID</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-hdd-network text-info"></i>
                    <span>Inbound Trunk</span>
                </div>
                <div class="pipeline-step-sub">ST_kcrc2jpfVgJ8</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-signpost-split text-warning"></i>
                    <span>Dispatch Rule</span>
                </div>
                <div class="pipeline-step-sub">Individual Rule</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-robot text-purple"></i>
                    <span>Canonical Agent</span>
                </div>
                <div class="pipeline-step-sub">wasid-*-master</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-door-open text-success"></i>
                    <span>Unique Room</span>
                </div>
                <div class="pipeline-step-sub">sip-in-{caller}_{hash}</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-cpu text-info"></i>
                    <span>Worker Session</span>
                </div>
                <div class="pipeline-step-sub">REALTIME / CASCADE</div>
            </div>
        </div>

        <!-- LiveKit Active Dispatch Rules Table -->
        <h6 class="text-white small fw-bold text-uppercase mb-2 d-flex align-items-center gap-2">
            <i class="bi bi-hdd-stack text-info"></i>
            <span>Active LiveKit SIP Dispatch Rules</span>
        </h6>
        <div class="table-responsive mb-4">
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>DID / Ingress Pattern</th>
                        <th>SIP Trunk</th>
                        <th>Dispatch Rule</th>
                        <th>Target Canonical Agent</th>
                        <th>Room Strategy</th>
                        <th>Worker Status</th>
                        <th>Routing Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in routing_matrix.routes %}
                    <tr>
                        <td>
                            <span class="badge {% if r.direction == 'INBOUND' %}bg-primary{% else %}bg-info{% endif %} bg-opacity-15 text-{{ 'primary' if r.direction == 'INBOUND' else 'info' }} border border-{{ 'primary' if r.direction == 'INBOUND' else 'info' }} border-opacity-30 px-2 py-1">
                                {{ r.direction }}
                            </span>
                        </td>
                        <td class="mono-cell fw-bold text-info">{{ r.did }}</td>
                        <td>
                            <div class="text-white">{{ r.trunk_name }}</div>
                            <small class="text-secondary mono-cell">{{ r.trunk_id }}</small>
                        </td>
                        <td>
                            <div class="text-white">{{ r.rule_name }}</div>
                            <small class="text-secondary mono-cell">{{ r.rule_id }}</small>
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-white mono-cell px-2 py-1">
                                {{ r.target_agent }}
                            </span>
                        </td>
                        <td class="mono-cell text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            {{ r.room_strategy }}
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-2 py-1">
                                {{ r.worker_status }}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-25 text-success">
                                {{ r.route_status }}
                            </span>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-secondary">
                            <div class="mb-2"><i class="bi bi-info-circle fs-4 text-warning"></i></div>
                            <div>No active SIP routes registered yet.</div>
                            <div class="small text-muted mt-1">Click <strong>"Provision Vobiz Rule"</strong> above to register the canonical individual dispatch rule.</div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Authoritative DIDs from PostgreSQL Global Source of Truth -->
        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h6 class="text-white mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-database-check text-info"></i>
                    <span>Authoritative Telephony DIDs (PostgreSQL Global Source of Truth)</span>
                    <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25">{{ routing_matrix.authoritative_did_count if routing_matrix else 0 }} DIDs</span>
                </h6>
                <div class="d-flex align-items-center gap-2">
                    {% if routing_matrix and routing_matrix.authoritative_did_count > 0 %}
                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25">
                        <i class="bi bi-check2-all me-1"></i> {{ routing_matrix.in_sync_did_count }}/{{ routing_matrix.authoritative_did_count }} In-Sync
                    </span>
                    {% else %}
                    <span class="badge bg-dark border border-secondary text-secondary">0 Assigned</span>
                    {% endif %}
                </div>
            </div>
            <div class="table-responsive">
                <table class="wl-table" style="font-size: 0.8125rem;">
                    <thead>
                        <tr>
                            <th>DID Number</th>
                            <th>Tenant Name</th>
                            <th>Tenant ID</th>
                            <th>Assigned Canonical Agent</th>
                            <th>Sync Health</th>
                            <th>Room Prefix</th>
                            <th>Source of Truth</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if routing_matrix and routing_matrix.did_routings %}
                        {% for d in routing_matrix.did_routings %}
                        <tr>
                            <td class="mono-cell fw-bold text-info">{{ d.did }}</td>
                            <td class="text-white">{{ d.tenant_name }}</td>
                            <td><code class="text-secondary" style="font-size: 0.75rem;">{{ d.tenant_id }}</code></td>
                            <td>
                                <span class="badge {% if d.agent_id == 'wasid-ai-automation-master' %}bg-primary{% else %}bg-purple{% endif %} bg-opacity-20 text-light border border-secondary border-opacity-25 px-2 py-1">
                                    {{ d.agent_id }}
                                </span>
                            </td>
                            <td>
                                {% if d.sync_status == 'IN-SYNC' %}
                                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25">
                                    <i class="bi bi-check-circle me-1"></i> IN-SYNC
                                </span>
                                {% else %}
                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-25">
                                    <i class="bi bi-exclamation-triangle me-1"></i> DRIFT
                                </span>
                                {% endif %}
                            </td>
                            <td class="mono-cell text-success">{{ d.room_prefix }}*</td>
                            <td>
                                <span class="badge bg-dark border border-secondary text-secondary" style="font-size:0.7rem;">PostgreSQL</span>
                            </td>
                        </tr>
                        {% endfor %}
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No customer DIDs are currently assigned in PostgreSQL.
                            </td>
                        </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 4. Live Telephony Sessions & Dispatches Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <div>
                <h5 class="wl-card-title">
                    <i class="bi bi-broadcast text-danger"></i>
                    Live Telephony Sessions & Active Dispatches
                </h5>
                <div class="text-secondary small mt-1">
                    Realtime WebRTC/SIP sessions & LiveKit Agent runtime dispatches
                </div>
            </div>
            <span class="text-muted small">Total Dispatches: <strong class="text-white">{{ total_dispatches }}</strong></span>
        </div>

        {% if telephony_sessions %}
        <div class="table-responsive mb-4">
            <h6 class="text-info small fw-bold text-uppercase mb-2 d-flex align-items-center gap-2">
                <i class="bi bi-activity text-danger"></i> Active Telephony Calls
            </h6>
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Call ID / Session</th>
                        <th>Direction</th>
                        <th>Caller Identity</th>
                        <th>Ingress DID</th>
                        <th>Assigned Agent</th>
                        <th>Room Name</th>
                        <th>Participants</th>
                        <th>Duration</th>
                        <th>Voice Mode</th>
                        <th>Status</th>
                        <th class="text-end">Telemetry</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in telephony_sessions %}
                    <tr>
                        <td class="mono-cell text-light">{{ s.room_name[:14] }}...</td>
                        <td>
                            <span class="badge bg-primary bg-opacity-25 text-primary">{{ s.direction }}</span>
                        </td>
                        <td class="mono-cell fw-bold">{{ s.caller }}</td>
                        <td class="mono-cell text-info">{{ s.did }}</td>
                        <td class="mono-cell text-white fw-semibold">{{ s.agent_name }}</td>
                        <td class="mono-cell text-success">{{ s.room_name }}</td>
                        <td>{{ s.num_participants }}</td>
                        <td>{{ s.duration }}</td>
                        <td><span class="badge bg-secondary">{{ s.provider_mode }}</span></td>
                        <td>
                            <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25">
                                <span class="wl-dot-green me-1" style="width:6px;height:6px;"></span> {{ s.status }}
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" onclick="showSessionTelemetry('{{ s.room_name }}', '{{ s.agent_name }}', '{{ s.caller }}', '{{ s.duration }}')">
                                <i class="bi bi-graph-up"></i> Telemetry
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="p-3 bg-dark bg-opacity-25 rounded border border-secondary border-opacity-25 mb-4 text-center text-secondary small">
            <i class="bi bi-telephone-inbound text-secondary me-1"></i> No active live telephony calls at this moment. Inbound calls via Vobiz carrier will appear here immediately.
        </div>
        {% endif %}

        <!-- Agent Dispatches List -->
        <h6 class="text-white small fw-bold text-uppercase mb-2 d-flex align-items-center gap-2">
            <i class="bi bi-cpu text-info"></i>
            <span>LiveKit Agent Runtime Dispatches</span>
        </h6>
        <div class="table-responsive">
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Dispatch ID</th>
                        <th>Agent Name</th>
                        <th>Target Room</th>
                        <th>Running Jobs</th>
                        <th>Total Jobs</th>
                        <th>Overall Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent_name, dispatches in agent_groups.items() %}
                        {% for d in dispatches %}
                        <tr>
                            <td class="mono-cell text-light">{{ d.id[:16] }}...</td>
                            <td>
                                <span class="badge bg-dark border border-secondary text-white mono-cell px-2 py-1">
                                    {{ d.agent_name }}
                                </span>
                            </td>
                            <td class="mono-cell text-info">{{ d.room }}</td>
                            <td>
                                {% if d.running_jobs > 0 %}
                                <span class="badge bg-success bg-opacity-25 text-success">{{ d.running_jobs }} running</span>
                                {% else %}
                                <span class="text-secondary">0</span>
                                {% endif %}
                            </td>
                            <td>{{ d.total_jobs }}</td>
                            <td>
                                {% if d.status == 'running' %}
                                <span class="badge bg-success">RUNNING</span>
                                {% else %}
                                <span class="badge bg-secondary">PENDING</span>
                                {% endif %}
                            </td>
                            <td class="small text-secondary">{{ d.created_at or '—' }}</td>
                            <td class="text-end">
                                <form action="/agents/{{ d.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Terminate and delete this agent dispatch?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="room" value="{{ d.room }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Terminate dispatch">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-secondary">
                            No agent dispatches currently running.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- 5. Slide-out Drawer: Agent 13 Dimensions Inspector -->
<div id="drawerBackdrop" class="wl-drawer-backdrop" onclick="closeSpecDrawer()"></div>

<div id="agentSpecDrawer" class="wl-drawer">
    <div class="wl-drawer-header">
        <div>
            <h5 class="mb-0 text-white fw-bold d-flex align-items-center gap-2">
