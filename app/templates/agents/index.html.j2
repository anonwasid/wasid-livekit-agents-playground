{% extends "base.html.j2" %}

{% block title %}WASID LIVE | Agent Control Center & Voice Telephony{% endblock %}

{% block extra_head %}
<style>
/* WASID LIVE Control Center — Dark Enterprise Theme */
:root {
    --wl-bg: #0d1117;
    --wl-surface: #161b22;
    --wl-surface-subtle: #21262d;
    --wl-border: #30363d;
    --wl-border-bright: #484f58;
    --wl-text-main: #f0f6fc;
    --wl-text-muted: #8b949e;
    --wl-text-subtle: #6e7681;
    --wl-blue: #388bfd;
    --wl-blue-bg: rgba(56, 139, 253, 0.12);
    --wl-green: #238636;
    --wl-green-text: #3fb950;
    --wl-green-bg: rgba(46, 160, 67, 0.12);
    --wl-amber: #d29922;
    --wl-amber-bg: rgba(210, 153, 34, 0.12);
    --wl-red: #f85149;
    --wl-red-bg: rgba(248, 81, 73, 0.12);
    --wl-purple: #a371f7;
    --wl-purple-bg: rgba(163, 113, 247, 0.12);
}

.wl-container {
    padding-bottom: 3.5rem;
}

/* Control Header */
.wl-header-bar {
    background: linear-gradient(180deg, #161b22 0%, #101318 100%);
    border: 1px solid var(--wl-border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
}

.wl-status-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
}

.wl-status-pill {
    background-color: var(--wl-surface-subtle);
    border: 1px solid var(--wl-border);
    color: var(--wl-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}

.wl-status-pill strong {
    color: var(--wl-text-main);
}

.wl-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--wl-green-text);
    box-shadow: 0 0 6px rgba(63, 185, 80, 0.5);
    display: inline-block;
}

.wl-dot-blue {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--wl-blue);
    display: inline-block;
}

/* Section Cards */
.wl-card {
    background-color: var(--wl-surface);
    border: 1px solid var(--wl-border);
    border-radius: 10px;
    padding: 1.35rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.wl-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.85rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--wl-border);
    flex-wrap: wrap;
    gap: 0.75rem;
}

.wl-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--wl-text-main);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    letter-spacing: 0.02em;
}

/* Agent Fleet Grid & Cards */
.agent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.25rem;
}

.agent-fleet-card {
    background-color: #11151d;
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.agent-fleet-card:hover {
    border-color: var(--wl-border-bright);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

.agent-fleet-card.primary-agent {
    border-left: 4px solid var(--wl-blue);
}

.agent-fleet-card.customer-agent {
    border-left: 4px solid var(--wl-purple);
}

.agent-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
}

.agent-id-tag {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--wl-text-main);
}

.agent-role-desc {
    font-size: 0.82rem;
    color: var(--wl-text-muted);
    margin-bottom: 1rem;
    line-height: 1.45;
}

.agent-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.wl-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.22rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--wl-border);
    background-color: var(--wl-surface-subtle);
    color: var(--wl-text-muted);
    white-space: nowrap;
}

.badge-blue {
    background-color: var(--wl-blue-bg);
    border-color: rgba(56, 139, 253, 0.35);
    color: #79c0ff;
}

.badge-green {
    background-color: var(--wl-green-bg);
    border-color: rgba(46, 160, 67, 0.35);
    color: #56d364;
}

.badge-purple {
    background-color: var(--wl-purple-bg);
    border-color: rgba(163, 113, 247, 0.35);
    color: #d2a8ff;
}

.badge-amber {
    background-color: var(--wl-amber-bg);
    border-color: rgba(210, 153, 34, 0.35);
    color: #e3b341;
}

.agent-metric-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background-color: #0b0e14;
    border: 1px solid var(--wl-border);
    border-radius: 6px;
    padding: 0.65rem 0.5rem;
    margin-bottom: 1.15rem;
    text-align: center;
}

.agent-metric-item {
    padding: 0 0.25rem;
}

.agent-metric-val {
    font-size: 0.95rem;
    font-weight: 700;
    font-family: 'SFMono-Regular', Consolas, monospace;
    color: var(--wl-text-main);
}

.agent-metric-lbl {
    font-size: 0.68rem;
    color: var(--wl-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
}

/* Voice Routing Matrix */
.routing-pipeline-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #0d1117;
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.35rem;
    overflow-x: auto;
    gap: 0.5rem;
}

.pipeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 125px;
    flex-shrink: 0;
}

.pipeline-step-box {
    background-color: var(--wl-surface-subtle);
    border: 1px solid var(--wl-border);
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--wl-text-main);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
}

.pipeline-step-sub {
    font-size: 0.68rem;
    color: var(--wl-text-subtle);
    margin-top: 0.35rem;
    font-family: 'SFMono-Regular', Consolas, monospace;
}

.pipeline-arrow {
    color: var(--wl-text-subtle);
    font-size: 1.15rem;
    padding: 0 0.35rem;
    flex-shrink: 0;
}

/* Operational Tables */
.wl-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.82rem;
}

.wl-table th {
    background-color: #12161f;
    color: var(--wl-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--wl-border);
    text-align: left;
    white-space: nowrap;
}

.wl-table td {
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid #21262d;
    color: var(--wl-text-main);
    vertical-align: middle;
}

.wl-table tr:hover td {
    background-color: rgba(255, 255, 255, 0.025);
}

.mono-cell {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.78rem;
}

/* Slide-out Drawer (Agent 13 Dimensions Inspector) */
.wl-drawer-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    z-index: 1050;
    backdrop-filter: blur(3px);
}

.wl-drawer {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 760px;
    max-width: 96vw;
    background-color: #11151d;
    border-left: 1px solid var(--wl-border);
    z-index: 1060;
    box-shadow: -12px 0 35px rgba(0, 0, 0, 0.6);
    flex-direction: column;
    animation: drawerSlideIn 0.22s ease-out;
}

@keyframes drawerSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
}

.wl-drawer.open {
    display: flex;
}

.wl-drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--wl-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #161b22;
    flex-shrink: 0;
}

.wl-drawer-nav {
    display: flex;
    gap: 0.25rem;
    padding: 0.55rem 1rem;
    background-color: #0b0e14;
    border-bottom: 1px solid var(--wl-border);
    overflow-x: auto;
    flex-shrink: 0;
    scrollbar-width: thin;
}

.wl-drawer-nav button {
    background: none;
    border: none;
    color: var(--wl-text-muted);
    font-size: 0.74rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 5px;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.15s ease;
}

.wl-drawer-nav button:hover {
    color: var(--wl-text-main);
    background-color: rgba(255, 255, 255, 0.04);
}

.wl-drawer-nav button.active {
    background-color: var(--wl-surface-subtle);
    color: #79c0ff;
    font-weight: 600;
}

.wl-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.35rem 1.5rem;
}

.spec-dim-card {
    background-color: #161b22;
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.15rem;
    margin-bottom: 1.15rem;
}

.spec-dim-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--wl-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
}

/* View Switcher Pills */
.view-switcher-btn {
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 5px;
    border: 1px solid var(--wl-border);
    background-color: var(--wl-surface-subtle);
    color: var(--wl-text-muted);
    cursor: pointer;
}

.view-switcher-btn.active {
    background-color: var(--wl-blue);
    border-color: var(--wl-blue);
    color: #ffffff;
    font-weight: 600;
}

/* Responsive adjustments */
@media (max-width: 992px) {
    .agent-grid {
        grid-template-columns: 1fr;
    }
    .routing-pipeline-diagram {
        justify-content: flex-start;
    }
}

@media (max-width: 768px) {
    .wl-header-bar {
        padding: 1rem;
    }
    .wl-status-strip {
        gap: 0.4rem;
    }
    .wl-drawer {
        width: 100vw;
        max-width: 100vw;
    }
    .agent-metric-strip {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
    }
}
</style>
{% endblock %}

{% block content %}
<div class="wl-container">

    <!-- Flash Notifications -->
    {% if flash_message %}
    <div class="alert alert-{{ flash_type or 'info' }} alert-dismissible fade show border-0 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi {% if flash_type == 'success' %}bi-check-circle-fill{% elif flash_type == 'danger' %}bi-exclamation-triangle-fill{% else %}bi-info-circle-fill{% endif %}"></i>
            <span>{{ flash_message }}</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- 1. Header & System Control Center -->
    <div class="wl-header-bar">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h4 class="mb-0 fw-bold text-white">WASID LIVE</h4>
                    <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-30 px-2 py-1">AGENT CONTROL CENTER</span>
                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-30 px-2 py-1">PHASE 7 SIP TELEPHONY</span>
                    <span class="badge bg-dark border border-secondary text-secondary px-2 py-1 mono-cell">CANONICAL DISPATCH</span>
                </div>
                <div class="text-secondary small">
                    Authoritative specifications synchronized with <a href="{{ fleet.authoritative_url }}" target="_blank" class="text-decoration-none text-info fw-semibold">{{ fleet.authoritative_source }}</a> | Deterministic SIP routing & dispatch
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form action="/agents/sync" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" title="Trigger instant server-side sync with agent.wasidai.com">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Sync Fleet</span>
                    </button>
                </form>

                <form action="/agents/provision-vobiz" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" title="Ensure canonical Vobiz individual dispatch rule is configured in LiveKit">
                        <i class="bi bi-shield-check"></i>
                        <span>Provision Vobiz Rule</span>
                    </button>
                </form>

                <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#outboundCallModal">
                    <i class="bi bi-telephone-outbound"></i>
                    <span>New Outbound Call</span>
                </button>

                <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#manualDispatchModal">
                    <i class="bi bi-play-circle"></i>
                    <span>Manual Dispatch</span>
                </button>
            </div>
        </div>

        <hr class="border-secondary my-3 opacity-25">

        <!-- Operational Status Strip -->
        <div class="wl-status-strip">
            <div class="wl-status-pill">
                <span class="wl-dot-green"></span>
                <span>LiveKit Gateway:</span>
                <strong>Connected ({{ latency_ms }}ms)</strong>
            </div>

            <div class="wl-status-pill">
                <span class="wl-dot-green"></span>
                <span>Workers:</span>
                <strong>{{ fleet.active_workers_summary }}</strong>
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-shield-lock-fill text-success"></i>
                <span>Spec Parity:</span>
                <strong class="text-success">{{ fleet.parity_percentage }} (Zero Drift)</strong>
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-telephone-fill text-info"></i>
                <span>Vobiz Readiness:</span>
                {% if routing_matrix.vobiz_ready %}
                <strong class="text-success">READY (Individual Rule Active)</strong>
                {% else %}
                <strong class="text-warning">Ready to Provision</strong>
                {% endif %}
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-activity text-primary"></i>
                <span>Active Calls:</span>
                <strong>{{ routing_matrix.active_sip_calls }}</strong>
            </div>

            <div class="wl-status-pill ms-lg-auto">
                <i class="bi bi-clock-history"></i>
                <span>Last Synchronized:</span>
                <span class="text-light">{{ fleet.last_synced_at }}</span>
            </div>
        </div>
    </div>

    <!-- 2. Agent Fleet Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <div>
                <h5 class="wl-card-title">
                    <i class="bi bi-robot text-primary"></i>
                    Synchronized Agent Fleet (Canonical Definitions)
                </h5>
                <div class="text-secondary small mt-1">
                    Canonical source: <span class="text-info">{{ fleet.authoritative_source }}</span> | Target for SIP Routing: <strong class="text-white">{{ routing_matrix.canonical_target_agent }}</strong>
                </div>
            </div>

            <!-- View Switcher -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="btnViewCards" class="view-switcher-btn active" onclick="switchFleetView('cards')">
                    <i class="bi bi-grid me-1"></i> Operational Cards
                </button>
                <button type="button" id="btnViewTable" class="view-switcher-btn" onclick="switchFleetView('table')">
                    <i class="bi bi-table me-1"></i> Compact Table
                </button>
            </div>
        </div>

        <!-- View 1: Compact Fleet Table (Operational Quick Scan) -->
        <div id="fleetTableView" class="table-responsive mb-3" style="display: none;">
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Canonical Agent</th>
                        <th>Type / Tenant</th>
                        <th>Status</th>
                        <th>Worker Pool</th>
                        <th>Voice Mode</th>
                        <th>Tools</th>
                        <th>Skills</th>
                        <th>Active Dispatches</th>
                        <th>Parity</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent in canonical_agents %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge {% if agent.id == 'wasid-ai-automation-master' %}bg-primary{% else %}bg-purple{% endif %} bg-opacity-20 text-light p-1 px-2 border border-secondary border-opacity-25">
                                    <i class="bi bi-robot"></i>
                                </span>
                                <div>
                                    <div class="mono-cell fw-bold text-white">{{ agent.id }}</div>
                                    <div class="text-secondary small" style="font-size:0.72rem;">{{ agent.name }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if agent.id == 'wasid-ai-automation-master' %}
                            <span class="badge bg-primary bg-opacity-15 text-primary border border-primary border-opacity-25">Internal Master</span>
                            {% else %}
                            <span class="badge bg-purple bg-opacity-15 text-purple border border-purple border-opacity-25" style="color:#d2a8ff; border-color:rgba(163,113,247,0.35);">Multi-Tenant Customer</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25">
                                <span class="wl-dot-green me-1" style="width:6px;height:6px;"></span> Active
                            </span>
                        </td>
                        <td>
                            <span class="text-light small"><i class="bi bi-cpu text-info me-1"></i> Online (Ready)</span>
                        </td>
                        <td>
                            <span class="badge {% if agent.id == 'wasid-ai-automation-master' %}badge-blue{% else %}badge-purple{% endif %}">
                                {{ agent.voice_mode or 'REALTIME / CASCADE' }}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-light mono-cell">{{ agent.tools|length }} tools</span>
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-light mono-cell">{{ agent.skills|length }} skills</span>
                        </td>
                        <td>
                            <span class="mono-cell text-info fw-bold">{{ agent_groups.get(agent.id, [])|length }}</span>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25">
                                <i class="bi bi-check-circle me-1"></i> 100% In-Sync
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="openSpecDrawer('{{ agent.id }}')" title="Inspect 13 Canonical Dimensions">
                                    <i class="bi bi-layers"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="populateDispatchModal('{{ agent.id }}')" title="Test Dispatch">
                                    <i class="bi bi-play-circle"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="prepareOutboundCall('{{ agent.id }}')" title="Place Outbound Call">
                                    <i class="bi bi-telephone-outbound"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- View 2: Operational Cards (Rich Overview) -->
        <div id="fleetCardsView" class="agent-grid">
            <!-- Card 1: wasid-ai-automation-master -->
            <div class="agent-fleet-card primary-agent">
                <div>
                    <div class="agent-header-row">
                        <div>
                            <div class="agent-id-tag">wasid-ai-automation-master</div>
                            <div class="text-info small fw-semibold">WASID AI Automation Master (Canonical Internal)</div>
                        </div>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30 px-2 py-1">DEFAULT SIP TARGET</span>
                    </div>

                    <div class="agent-role-desc">
                        Authoritative WASID Master Agent representing internal operations, system inspection, and voice automation. Synchronized from immutable canonical specification.
                    </div>

                    <div class="agent-badges">
                        <span class="wl-badge badge-blue">REALTIME / CASCADE</span>
                        <span class="wl-badge badge-green">LiteLLM wasid-live</span>
                        <span class="wl-badge badge-green">Groq Whisper STT</span>
                        <span class="wl-badge badge-blue">Gemini Live + TTS</span>
                        <span class="wl-badge badge-purple">Silero VAD</span>
                        <span class="wl-badge">v1.2.0-prod</span>
                    </div>

                    <div class="agent-metric-strip">
                        <div class="agent-metric-item">
                            <div class="agent-metric-val">12</div>
                            <div class="agent-metric-lbl">Tools</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val">5</div>
                            <div class="agent-metric-lbl">Skills</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val text-success">100%</div>
                            <div class="agent-metric-lbl">Parity</div>
                        </div>
                        <div class="agent-metric-item">
                            <div class="agent-metric-val text-info">{{ agent_groups.get('wasid-ai-automation-master', [])|length }}</div>
                            <div class="agent-metric-lbl">Dispatches</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1" onclick="openSpecDrawer('wasid-ai-automation-master')">
                        <i class="bi bi-layers"></i>
