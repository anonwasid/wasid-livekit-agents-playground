        <!-- Tab 7: MCP -->
        <div id="tab-mcp" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-link-45deg"></i> Dimension 7: Model Context Protocol (MCP)</div>
                <div id="dim-mcp-content" class="text-light small"></div>
            </div>
        </div>

        <!-- Tab 8: Knowledge -->
        <div id="tab-knowledge" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-book"></i> Dimension 8: Knowledge & Context</div>
                <div id="dim-knowledge-content" class="text-light small"></div>
            </div>
        </div>

        <!-- Tab 9: Memory -->
        <div id="tab-memory" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
