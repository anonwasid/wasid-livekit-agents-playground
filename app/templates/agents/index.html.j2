<!-- DISPATCH AGENT MODAL -->
<div class="modal fade" id="createDispatchModal" tabindex="-1" aria-labelledby="createDispatchModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary">
            <form action="/agents/dispatch" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold text-light" id="createDispatchModalLabel">
                        <i class="bi bi-send-fill text-primary"></i> Dispatch Agent to LiveKit Room
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="agent_name_select" class="form-label text-light small fw-bold">Select Canonical Agent</label>
                        <select class="form-select bg-dark text-light border-secondary" id="agent_name_select" name="agent_name" required>
                            <option value="wasid-ai-automation-master" selected>wasid-ai-automation-master (Internal Operations)</option>
                            <option value="wasid-customer-master">wasid-customer-master (Customer Multi-Tenant)</option>
                        </select>
                        <div class="form-text text-muted">Authoritative master agent identities synchronized from agent.wasidai.com.</div>
                    </div>
                    <div class="mb-3">
                        <label for="room_name_input" class="form-label text-light small fw-bold">Target LiveKit Room Name</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary font-monospace" id="room_name_input" name="room" placeholder="e.g. room-demo-001 or voice-internal" required>
                        <div class="form-text text-muted">The agent worker will be assigned to this LiveKit room.</div>
                    </div>
                    <div class="mb-3">
                        <label for="metadata_input" class="form-label text-light small fw-bold">Metadata (Optional JSON)</label>
                        <textarea class="form-control bg-dark text-light border-secondary font-monospace small" id="metadata_input" name="metadata" rows="2" placeholder='{"tenant_id": "WAS12345678", "mode": "voice"}'></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-send-fill"></i> Dispatch Now
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
let currentInspectedSpec = null;

// Filter agents in cards view
function filterAgents() {
    const q = document.getElementById('agentFilterInput').value.toLowerCase();
    const cols = document.querySelectorAll('.agent-card-col');
    cols.forEach(col => {
        const text = col.getAttribute('data-search-term').toLowerCase();
        col.style.display = text.includes(q) ? '' : 'none';
    });
}

// Prefill and open dispatch modal
function prefillDispatchModal(agentId) {
    const sel = document.getElementById('agent_name_select');
    if (sel) {
        for (let i = 0; i < sel.options.length; i++) {
            if (sel.options[i].value === agentId) {
                sel.selectedIndex = i;
                break;
            }
        }
    }
    const modalEl = document.getElementById('createDispatchModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}

// Open 13 dimensions specification inspector
async function openSpecInspector(agentId) {
    const modalEl = document.getElementById('specInspectorModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();

    // 1. Instant client-side inspection if embedded
    const scriptEl = document.getElementById('spec-data-' + agentId);
    if (scriptEl) {
        try {
            const data = JSON.parse(scriptEl.textContent);
            currentInspectedSpec = data;
            populateInspector(data);
            return;
        } catch(e) {
            console.error('Error parsing embedded spec:', e);
        }
    }

    // 2. Fallback to API
    document.getElementById('spec-raw-json').textContent = 'Fetching full canonical specification from agent.wasidai.com...';
    try {
        const resp = await fetch(`/agents/api/spec/${encodeURIComponent(agentId)}`);
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const data = await resp.json();
        currentInspectedSpec = data;
        populateInspector(data);
    } catch (e) {
        document.getElementById('spec-raw-json').textContent = `Error loading specification: ${e}`;
    }
}

function populateInspector(data) {
    const cfg = data.config || {};
    const identity = cfg.identity || {};
    const behavior = cfg.behavior || {};

    document.getElementById('specInspectorModalLabel').textContent = `Agent Live Inspection • ${data.name || data.agent_id}`;
    document.getElementById('spec-id').textContent = data.agent_id || '-';
    document.getElementById('spec-name').textContent = data.name || '-';
    document.getElementById('spec-type').textContent = data.agent_type || '-';
    document.getElementById('spec-role').textContent = identity.role || data.description || '-';
    document.getElementById('spec-checksum').textContent = data.checksum || '-';

    document.getElementById('spec-tone').textContent = behavior.tone || 'professional, decisive, authoritative';
    document.getElementById('spec-instructions').textContent = behavior.system_instructions || 'Authoritative AI agent instructions.';

    // Skills
    const skillsList = document.getElementById('spec-skills-list');
    skillsList.innerHTML = '';
    const skills = cfg.skills || ['workflow_orchestration', 'telemetry_diagnostics'];
    skills.forEach(s => {
        const li = document.createElement('li');
        li.className = 'py-1 border-bottom border-secondary border-opacity-25';
        li.innerHTML = `<i class="bi bi-check2-circle text-success me-1"></i> <code>${s}</code>`;
        skillsList.appendChild(li);
    });

    // Tools
    const toolsContainer = document.getElementById('spec-tools-list');
    toolsContainer.innerHTML = '';
    const tools = cfg.tools || ['wasid.crm.syncRecord', 'wasid.telephony.transferCall'];
    tools.forEach(t => {
        const tName = typeof t === 'string' ? t : (t.name || t.tool_id);
        const div = document.createElement('div');
        div.className = 'p-1.5 mb-1 rounded bg-dark border border-secondary border-opacity-25 d-flex justify-content-between align-items-center';
        div.innerHTML = `<code>${tName}</code> <span class="badge bg-success bg-opacity-25 text-success" style="font-size:0.65rem;">LOADED</span>`;
        toolsContainer.appendChild(div);
    });

    // MCP
    const mcpList = document.getElementById('spec-mcp-list');
    mcpList.innerHTML = '';
    const mcps = cfg.mcp_servers || ['coolify-mcp', 'n8n-mcp'];
    mcps.forEach(m => {
        const li = document.createElement('li');
        li.className = 'py-1 border-bottom border-secondary border-opacity-25';
        li.innerHTML = `<i class="bi bi-hdd-rack text-info me-1"></i> <code>${m}</code>`;
        mcpList.appendChild(li);
    });

    // Workflows
    const wfList = document.getElementById('spec-workflows-list');
    wfList.innerHTML = '';
    const wfs = cfg.n8n_workflows || ['wf_internal_lead_sync'];
    wfs.forEach(w => {
        const div = document.createElement('div');
        div.className = 'p-1 mb-1 font-monospace text-light';
        div.innerHTML = `<i class="bi bi-play-circle text-primary me-1"></i> ${w}`;
        wfList.appendChild(div);
    });

    // Knowledge
    const knList = document.getElementById('spec-knowledge-list');
    knList.innerHTML = '';
    const kns = cfg.knowledge_sources || ['internal_sop', 'telemetry_logs'];
    kns.forEach(k => {
        const div = document.createElement('div');
        div.className = 'p-1 mb-1 font-monospace text-light';
        div.innerHTML = `<i class="bi bi-file-earmark-text text-secondary me-1"></i> ${k}`;
        knList.appendChild(div);
    });

    // Raw JSON
    document.getElementById('spec-raw-json').textContent = JSON.stringify(data, null, 2);
}

function copyJsonSpec() {
    if (!currentInspectedSpec) return;
    navigator.clipboard.writeText(JSON.stringify(currentInspectedSpec, null, 2));
    alert('Canonical specification JSON copied to clipboard.');
}

function dispatchCurrentInspectedAgent() {
    if (!currentInspectedSpec) return;
    const modalEl = document.getElementById('specInspectorModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
    prefillDispatchModal(currentInspectedSpec.agent_id);
}
</script>
{% endblock %}
