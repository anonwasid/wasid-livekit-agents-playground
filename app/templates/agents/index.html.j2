{% extends "base.html.j2" %}

{% block title %}WASID Agent Fleet Operations - LiveKit Dashboard{% endblock %}

{% block extra_head %}
<style>
:root {
    --stitch-bg: #0b0f19;
    --stitch-surface: #111827;
    --stitch-surface-high: #1f2937;
    --stitch-surface-higher: #374151;
    --stitch-primary: #06b6d4;
    --stitch-primary-glow: rgba(6, 182, 212, 0.25);
    --stitch-success: #10b981;
    --stitch-success-glow: rgba(16, 185, 129, 0.25);
    --stitch-secondary: #818cf8;
    --stitch-border: #1e293b;
    --stitch-border-bright: #334155;
    --stitch-text-muted: #94a3b8;
}

.stitch-card {
    background-color: var(--stitch-surface);
    border: 1px solid var(--stitch-border);
    border-radius: 8px;
    transition: all 0.2s ease-in-out;
}
.stitch-card:hover {
    border-color: var(--stitch-border-bright);
}
.stitch-card-active {
    border: 2px solid var(--stitch-primary) !important;
    box-shadow: 0 0 20px var(--stitch-primary-glow);
}
.stitch-metric-val {
    font-family: 'JetBrains Mono', monospace, ui-monospace;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}
.stitch-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}
.badge-auth {
    background-color: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--stitch-border-bright);
    color: #cbd5e1;
}
.badge-synced {
    background-color: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
}
.badge-pipeline {
    background-color: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #a5b4fc;
}
.badge-spec {
    background-color: var(--stitch-surface-high);
    border: 1px solid var(--stitch-border);
    color: #e2e8f0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
}
.pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.pulse-green {
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: green-pulse 2s infinite;
}
@keyframes green-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}
.json-view {
    background-color: #090d16;
    color: #38bdf8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    padding: 1rem;
    border-radius: 6px;
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid var(--stitch-border);
}
</style>
{% endblock %}

{% block page_header %}
<div class="d-flex flex-column">
    <div class="d-flex align-items-center gap-2">
        <h1 class="page-title mb-0">WASID Agent Fleet</h1>
        <span class="badge bg-primary text-dark fw-bold px-2 py-1" style="font-size: 0.7rem;">SYNCHRONIZED</span>
    </div>
    <p class="page-subtitle mb-0 text-muted" style="font-size: 0.85rem;">
        Authoritative Source: <a href="{{ fleet.authoritative_url }}" target="_blank" class="text-info text-decoration-none fw-semibold">{{ fleet.authoritative_source }}</a>
        • Projection: <code>lkdashboard.wasidai.com/agents</code>
    </p>
</div>
<div class="top-bar-actions d-flex align-items-center gap-2">
    <!-- Trigger Fleet Re-Sync Form -->
    <form action="/agents/sync" method="POST" class="m-0">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button type="submit" class="btn btn-outline-info btn-sm d-flex align-items-center gap-1" title="Force immediate re-sync with agent.wasidai.com">
            <i class="bi bi-arrow-repeat"></i>
            <span>Re-Sync Fleet</span>
        </button>
    </form>
    
    <!-- Dispatch Agent Button -->
    <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#createDispatchModal">
        <i class="bi bi-send-fill"></i>
        <span>Dispatch Agent</span>
    </button>
</div>
{% endblock %}

{% block content %}
<!-- Real-Time Telemetry & Drift Status Banner -->
<div class="stitch-card p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3" style="background: linear-gradient(90deg, #111827 0%, #0f172a 100%);">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="pulse-dot pulse-green"></span>
            <span class="text-muted small">LiveKit Gateway:</span>
            <code class="text-light px-2 py-0.5 rounded" style="background: rgba(0,0,0,0.4); font-size:0.8rem;">{{ fleet.livekit_gateway }}</code>
        </div>
        <div class="vr bg-secondary d-none d-md-block" style="opacity: 0.3; height: 16px;"></div>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-success fs-5"></i>
            <span class="text-muted small">Drift Detection:</span>
            <span class="text-success fw-semibold small">{{ fleet.drift_summary }}</span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="badge badge-auth">
            <i class="bi bi-lock-fill text-warning"></i> Authoritative Source: {{ fleet.authoritative_source }}
        </span>
        <span class="text-muted small" style="font-family: monospace;">Sync: {{ fleet.last_synced_at }}</span>
    </div>
</div>

<!-- 4 High-Density Hero Fleet Metric Cards -->
<div class="row g-3 mb-4" id="hero-metrics">
    <!-- Card 1: Total Registered Agents -->
    <div class="col-xl-3 col-md-6">
        <div class="stitch-card p-3 h-100 d-flex flex-col justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Total Registered</span>
                <i class="bi bi-robot text-primary fs-4" style="opacity: 0.7;"></i>
            </div>
            <div>
                <div class="stitch-metric-val text-light">{{ fleet.total_registered_agents }}</div>
                <div class="text-info small fw-medium">Canonical Agent Definitions</div>
            </div>
            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between text-muted small">
                <span>Scope</span>
                <span class="text-light">Internal + Customer</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Active Workers -->
    <div class="col-xl-3 col-md-6">
        <div class="stitch-card p-3 h-100 d-flex flex-col justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Active Workers</span>
                <span class="pulse-dot pulse-green"></span>
            </div>
            <div>
                <div class="stitch-metric-val text-success">{{ fleet.active_workers_summary }}</div>
                <div class="text-muted small">Readiness: 100% Worker Pool</div>
            </div>
            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between text-muted small">
                <span>Heartbeat</span>
                <span class="text-success">Active &bull; Cluster Healthy</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Active Sessions & Rooms -->
    <div class="col-xl-3 col-md-6">
        <div class="stitch-card p-3 h-100 d-flex flex-col justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Active Sessions</span>
                <i class="bi bi-broadcast text-warning fs-4" style="opacity: 0.7;"></i>
            </div>
            <div>
                <div class="stitch-metric-val text-light">{{ fleet.active_sessions }} Calls</div>
                <div class="text-muted small">Across {{ fleet.total_rooms }} LiveKit Rooms</div>
            </div>
            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between text-muted small">
                <span>SDK Latency</span>
                <span class="text-warning fw-semibold">{{ fleet.sdk_latency_ms }} ms</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Fleet Sync Status -->
    <div class="col-xl-3 col-md-6">
        <div class="stitch-card p-3 h-100 d-flex flex-col justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Fleet Sync Status</span>
                <i class="bi bi-cloud-check-fill text-success fs-4" style="opacity: 0.8;"></i>
            </div>
            <div>
                <div class="stitch-metric-val text-info d-flex align-items-center gap-2">
                    {{ fleet.fleet_sync_status }}
                    <i class="bi bi-patch-check-fill text-success" style="font-size: 1.25rem;"></i>
                </div>
                <div class="text-success small fw-medium">{{ fleet.parity_percentage }} Specification Parity</div>
            </div>
            <div class="mt-3 pt-2 border-top border-secondary border-opacity-25 d-flex justify-content-between text-muted small">
                <span>Last Updated</span>
                <span class="text-light">{{ fleet.last_synced_at }}</span>
            </div>
        </div>
    </div>
</div>

<!-- CANONICAL AGENT CARDS GRID -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold">Canonical WASID Master Agents</h4>
        <p class="text-muted small mb-0">Authoritative agents projected from <code>{{ fleet.authoritative_source }}</code> with LiveKit dispatch bindings</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <input type="text" id="agentFilterInput" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Filter agents by name or tool..." style="width: 260px;" onkeyup="filterAgents()">
    </div>
</div>

<div class="row g-4 mb-5" id="canonical-agents-row">
    {% for agent in canonical_agents %}
    <!-- Hidden JSON spec tag for instant 0ms inspector loading -->
    <script type="application/json" id="spec-data-{{ agent.agent_id }}">{{ agent | tojson | safe }}</script>

    <div class="col-lg-6 agent-card-col" data-agent-id="{{ agent.agent_id }}" data-search-term="{{ agent.name }} {{ agent.agent_id }} {{ agent.description }} {{ agent.display_subtitle }}">
        <div class="stitch-card p-4 h-100 d-flex flex-column justify-content-between {% if loop.first %}stitch-card-active{% endif %}">
            <div>
                <!-- Card Header: Title & Badges -->
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-cpu-fill text-primary fs-4"></i>
                            <h5 class="fw-bold text-light mb-0" style="font-family: 'JetBrains Mono', monospace;">{{ agent.agent_id }}</h5>
                            {% if loop.first %}
                            <span class="badge bg-primary text-dark fw-bold px-1.5 py-0.5" style="font-size:0.65rem;">PRIMARY</span>
                            {% endif %}
                        </div>
                        <div class="text-muted small mt-1">{{ agent.display_subtitle }}</div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-1.5">
                        <span class="stitch-badge badge-auth" title="Source of truth is agent.wasidai.com">
                            <i class="bi bi-lock-fill text-warning"></i> Authoritative
                        </span>
                        <span class="stitch-badge badge-synced" title="Local LiveKit projection is synchronized">
                            <i class="bi bi-check-circle-fill"></i> Synced
                        </span>
                    </div>
                </div>

                <!-- LiveKit Runtime & Pool Status Matrix -->
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 h-100">
                            <div class="text-muted small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">LiveKit Runtime State</div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="pulse-dot pulse-green"></span>
                                <span class="text-light fw-semibold small">{{ agent.runtime_status }}</span>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 0.72rem;">{{ agent.active_rooms_count }} Active Room(s) &bull; {{ agent.active_sessions }} In-Call</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 h-100">
                            <div class="text-muted small text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Worker Pool Readiness</div>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <span class="text-light fw-semibold small">Online &bull; Ready</span>
                                <span class="text-success small"><i class="bi bi-activity"></i> Active</span>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 0.72rem;">Cluster: us-east-1 &bull; 100% Health</div>
                        </div>
                    </div>
                </div>

                <!-- Spec Checksum & Pipeline Target -->
                <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 mb-3 d-flex flex-wrap justify-content-between align-items-center small" style="font-size: 0.75rem;">
                    <span class="text-muted">Spec Checksum: <code class="text-info">{{ agent.checksum }}</code></span>
                    <span class="text-muted">Target: <span class="text-light fw-medium">{{ agent.target_pipeline }}</span></span>
                </div>

                <!-- Configuration Preview Badges -->
                <div class="d-flex flex-wrap gap-1.5 mb-4">
                    <span class="stitch-badge badge-spec"><i class="bi bi-tools text-primary"></i> {{ agent.tools_count }} Tools Loaded</span>
                    <span class="stitch-badge badge-spec"><i class="bi bi-lightning-charge text-warning"></i> {{ agent.skills_count }} Skills Active</span>
                    <span class="stitch-badge badge-spec"><i class="bi bi-building text-info"></i> {{ agent.role_scope }}</span>
                    <span class="stitch-badge badge-pipeline"><i class="bi bi-mic-fill"></i> {{ agent.voice_pipeline_label }}</span>
                </div>
            </div>

            <!-- Action Controls Footer -->
            <div class="pt-3 border-top border-secondary border-opacity-25 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-light btn-sm d-flex align-items-center gap-1.5" onclick="openSpecInspector('{{ agent.agent_id }}')">
                        <i class="bi bi-card-checklist text-info"></i>
                        <span>Inspect 13 Dimensions</span>
                    </button>
                    <a href="/agents/{{ agent.agent_id }}" class="btn btn-outline-secondary btn-sm" title="View agent execution history">
                        <i class="bi bi-clock-history"></i> History
                    </a>
                </div>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1.5 shadow-sm" onclick="prefillDispatchModal('{{ agent.agent_id }}')">
                    <i class="bi bi-send-fill"></i>
                    <span>Dispatch to Room</span>
                </button>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- ACTIVE LIVEKIT DISPATCHES TABLE -->
<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h5 class="mb-0 fw-bold">Active LiveKit Room Dispatches</h5>
        <p class="text-muted small mb-0">Real-time room dispatch bindings active on the LiveKit server</p>
    </div>
</div>

<div class="card mb-4" id="dispatches-table">
    <div class="card-body p-0">
        {% if agent_groups %}
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Agent Identity</th>
                        <th>Sessions</th>
                        <th>Bound Rooms</th>
                        <th>Dispatch Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent_name, dispatches in agent_groups.items() %}
                    {% set running = dispatches | selectattr('status', 'equalto', 'running') | list | length %}
                    {% set first = dispatches[0] %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-robot text-primary"></i>
                                <a href="/agents/{{ agent_name }}" class="text-light fw-semibold text-decoration-none" style="font-family: monospace;">
                                    {{ agent_name }}
                                </a>
                            </div>
                        </td>
                        <td>
                            <span class="badge {% if running > 0 %}bg-success text-dark{% else %}bg-secondary{% endif %}">
                                {{ running }} running
                            </span>
                        </td>
                        <td>
                            {% set rooms = dispatches | map(attribute='room') | unique | list %}
                            <span class="text-muted small">{{ rooms | join(', ') if rooms else 'None' }}</span>
                        </td>
                        <td>
                            {% if running > 0 %}
                            <span class="text-success small fw-semibold"><i class="bi bi-play-circle-fill"></i> Running</span>
                            {% else %}
                            <span class="text-muted small"><i class="bi bi-pause-circle"></i> Pending / Idle</span>
                            {% endif %}
                        </td>
                        <td class="text-muted small">{{ first.created_at or 'N/A' }}</td>
                        <td class="text-end">
                            <button class="btn btn-outline-info btn-sm py-0 px-2" onclick="prefillDispatchModal('{{ agent_name }}')">
                                Dispatch
                            </button>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="bi bi-broadcast text-secondary fs-1 mb-2"></i>
            <h6 class="text-light">No Active Explicit Room Dispatches</h6>
            <p class="text-muted small mb-3">Both canonical agents are registered and ready. Use the Dispatch button to route an agent into a LiveKit room.</p>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createDispatchModal">
                <i class="bi bi-plus-circle"></i> Dispatch Agent Now
            </button>
        </div>
        {% endif %}
    </div>
</div>

<!-- 13 DIMENSIONS AGENT INSPECTION MODAL -->
<div class="modal fade" id="specInspectorModal" tabindex="-1" aria-labelledby="specInspectorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-card-heading text-info fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold text-light mb-0" id="specInspectorModalLabel">Agent Live Inspection &bull; 13 Dimensions</h5>
                        <div class="text-muted small" id="inspectorAgentSubtitle">Canonical specification projection from agent.wasidai.com</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Lock Notice -->
                <div class="p-2 px-3 bg-secondary bg-opacity-10 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2 small">
                    <i class="bi bi-lock-fill text-warning"></i>
                    <span class="text-muted">
                        <strong class="text-light">Authoritative Spec (Read-Only):</strong> Source of truth is <span class="text-info fw-bold">agent.wasidai.com</span>. LiveKit operational surface controls room dispatch and runtime telemetry.
                    </span>
                </div>

                <!-- Tabs -->
                <ul class="nav nav-tabs nav-fill bg-dark border-bottom border-secondary border-opacity-25" id="inspectorTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active text-light small py-2.5" id="tab-identity-btn" data-bs-toggle="tab" data-bs-target="#tab-identity" type="button">
                            1-2. Identity & Behavior
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-light small py-2.5" id="tab-voice-btn" data-bs-toggle="tab" data-bs-target="#tab-voice" type="button">
                            3, 10. Voice & Models
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-light small py-2.5" id="tab-tools-btn" data-bs-toggle="tab" data-bs-target="#tab-tools" type="button">
                            4-6. Skills & Tools
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-light small py-2.5" id="tab-channels-btn" data-bs-toggle="tab" data-bs-target="#tab-channels" type="button">
                            7, 9, 11. Omnichannel & Workflows
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-light small py-2.5" id="tab-security-btn" data-bs-toggle="tab" data-bs-target="#tab-security" type="button">
                            8, 12-13. Memory & Security
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link text-light small py-2.5" id="tab-json-btn" data-bs-toggle="tab" data-bs-target="#tab-json" type="button">
                            Raw JSON Spec
                        </button>
                    </li>
                </ul>

                <!-- Tab Contents -->
                <div class="tab-content p-3" id="inspectorTabContent">
                    <!-- Tab 1: Identity & Behavior -->
                    <div class="tab-pane fade show active" id="tab-identity" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="stitch-card p-3">
                                    <h6 class="text-info fw-bold mb-3"><i class="bi bi-person-badge"></i> Dimension 1: Identity</h6>
                                    <table class="table table-sm table-borderless text-light mb-0" style="font-size:0.85rem;">
                                        <tr><td class="text-muted" style="width: 35%;">Agent ID</td><td id="spec-id" class="fw-bold text-info font-monospace">-</td></tr>
                                        <tr><td class="text-muted">Display Name</td><td id="spec-name" class="fw-bold">-</td></tr>
                                        <tr><td class="text-muted">Agent Type</td><td id="spec-type" class="font-monospace">-</td></tr>
                                        <tr><td class="text-muted">Role & Scope</td><td id="spec-role">-</td></tr>
                                        <tr><td class="text-muted">Checksum</td><td id="spec-checksum" class="font-monospace text-warning">-</td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="stitch-card p-3">
                                    <h6 class="text-info fw-bold mb-3"><i class="bi bi-chat-quote"></i> Dimension 2: Behavior</h6>
                                    <div class="mb-2">
                                        <div class="text-muted small">Tone & Style:</div>
                                        <div id="spec-tone" class="text-light fw-medium small">-</div>
                                    </div>
                                    <div>
                                        <div class="text-muted small">System Instructions Preview:</div>
