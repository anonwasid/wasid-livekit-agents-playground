                <div class="mb-2"><strong class="text-secondary small">Primary LLM:</strong> <span id="dim-model" class="text-info mono-cell fw-bold"></span></div>
                <div class="mb-2"><strong class="text-secondary small">Fallback Model:</strong> <span id="dim-fallback-model" class="text-white mono-cell"></span></div>
                <div class="mb-2"><strong class="text-secondary small">LiteLLM Gateway:</strong> <span id="dim-gateway" class="text-success"></span></div>
                <div class="mb-0"><strong class="text-secondary small">Quota Failover:</strong> <span class="badge bg-dark border border-secondary text-secondary">Automatic Multi-Key Rotation</span></div>
            </div>
        </div>

        <!-- Tab 5: Skills -->
        <div id="tab-skills" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-magic"></i> Dimension 5: Skills Registry</div>
                <ul id="dim-skills-list" class="list-unstyled mb-0" style="font-size:0.8rem;"></ul>
            </div>
        </div>

        <!-- Tab 6: Tools -->
        <div id="tab-tools" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-tools"></i> Dimension 6: Tools Registry</div>
                <ul id="dim-tools-list" class="list-unstyled mb-0" style="font-size:0.8rem;"></ul>
