                <div id="dim-memory-content" class="text-light small"></div>
            </div>
        </div>

        <!-- Tab 10: Omnichannel -->
        <div id="tab-omnichannel" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-chat-dots"></i> Dimension 10: Omnichannel Capabilities</div>
                <div id="dim-omnichannel-content" class="text-light small"></div>
            </div>
        </div>

        <!-- Tab 11: SIP Routing -->
        <div id="tab-sip" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-telephone"></i> Dimension 11: SIP Telephony Routing</div>
                <div class="mb-2"><strong class="text-secondary small">Routing Model:</strong> <span class="text-white">Deterministic Inbound & Outbound</span></div>
                <div class="mb-2"><strong class="text-secondary small">Room Strategy:</strong> <span class="text-success mono-cell">sip-in-{caller}_{hash}</span></div>
                <div class="mb-2"><strong class="text-secondary small">Collision Prevention:</strong> <span class="badge bg-success">1 Call = 1 Unique Room</span></div>
                <div class="mb-2"><strong class="text-secondary small">Vobiz Carrier Binding:</strong> <span class="text-info">LiveKit Inbound Trunk (ST_kcrc2jpfVgJ8)</span></div>
                <div class="mb-0"><strong class="text-secondary small">Automatic Agent Dispatch:</strong> <span class="text-light">RoomAgentDispatch (Zero Manual Operator Click)</span></div>
            </div>
        </div>

        <!-- Tab 12: n8n Engine -->
        <div id="tab-n8n" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-diagram-2"></i> Dimension 12: n8n Automation Engine</div>
                <div class="mb-2"><strong class="text-secondary small">Engine Status:</strong> <span class="badge bg-warning text-dark">Phase 3 FROZEN</span></div>
                <div class="mb-2"><strong class="text-secondary small">Target Tenant:</strong> <span class="mono-cell text-info">FitZone Gym</span></div>
                <div class="mb-2"><strong class="text-secondary small">Master Workflow ID:</strong> <span class="mono-cell text-light">SDzn8as7t9O9g9ct</span></div>
                <div class="mb-0"><strong class="text-secondary small">Integration Type:</strong> <span class="text-white">Asynchronous Webhook & Trigger Orchestration</span></div>
            </div>
        </div>

        <!-- Tab 13: Security & Version -->
        <div id="tab-security" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-shield-check"></i> Dimension 13: Security, Version & Parity Checksums</div>
                <div class="mb-2"><strong class="text-secondary small">SHA-256 Checksum:</strong> <span id="dim-checksum" class="mono-cell text-warning" style="font-size:0.75rem;"></span></div>
                <div class="mb-2"><strong class="text-secondary small">Parity Status:</strong> <span id="dim-drift" class="badge bg-success">100% (Zero Drift)</span></div>
                <div class="mb-2"><strong class="text-secondary small">Authoritative State:</strong> <span class="text-white">agent.wasidai.com (Read-Only)</span></div>
                <div class="mb-0"><strong class="text-secondary small">RBAC Guard:</strong> <span class="text-white">LiveKit Admin Basic Auth Required</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Outbound Call -->
<div class="modal fade" id="outboundCallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-telephone-outbound text-primary"></i>
                    <span>Initiate Outbound Call</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/agents/outbound-call" method="post">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Select Outbound Trunk</label>
                        <select class="form-select bg-black text-light border-secondary" name="sip_trunk_id" required>
                            {% for ot in outbound_trunks %}
                            <option value="{{ ot.sip_trunk_id or ot.id }}">
                                {{ ot.name or ot.sip_trunk_id or ot.id }} ({{ ot.numbers|join(', ') if ot.numbers else 'Default' }})
                            </option>
                            {% else %}
                            <option value="demo_trunk">Default Outbound Carrier Trunk</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Destination Phone Number</label>
                        <input type="text" class="form-control bg-black text-light border-secondary" name="sip_call_to" placeholder="+971501234567" required>
                        <div class="form-text text-muted" style="font-size:0.72rem;">Include country code in E.164 format.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Dispatch Canonical Agent</label>
                        <select class="form-select bg-black text-light border-secondary" name="agent_name" id="outboundAgentSelect">
                            <option value="wasid-ai-automation-master" selected>wasid-ai-automation-master (Default Master)</option>
                            <option value="wasid-customer-master">wasid-customer-master (Customer Tenant)</option>
                        </select>
                    </div>

                    <div class="p-2 bg-black rounded border border-secondary text-info small" style="font-size:0.72rem;">
                        <i class="bi bi-shield-check me-1"></i>
                        A unique collision-safe room (<code>sip-out-{timestamp}_{uuid}</code>) will be created automatically and the agent will be pre-dispatched.
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Place Outbound Call</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Manual Dispatch -->
<div class="modal fade" id="manualDispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-play-circle text-primary"></i>
                    <span>Manual Agent Dispatch (Testing)</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/agents/dispatch" method="post">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Agent Name</label>
                        <select class="form-select bg-black text-light border-secondary" name="agent_name" id="manualDispatchAgentSelect">
                            <option value="wasid-ai-automation-master">wasid-ai-automation-master</option>
                            <option value="wasid-customer-master">wasid-customer-master</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Target Room Name</label>
                        <input type="text" class="form-control bg-black text-light border-secondary" name="room" id="manualDispatchRoomInput" placeholder="room-test-01" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold">Optional Metadata (JSON)</label>
                        <textarea class="form-control bg-black text-light border-secondary" name="metadata" rows="2" placeholder='{"caller": "tester"}'></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Dispatch Agent</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Session Telemetry Drawer/Modal -->
<div class="modal fade" id="sessionTelemetryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark border border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-graph-up text-info"></i>
                    <span>Real-time Voice Session Telemetry</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-black rounded border border-secondary">
                            <div class="text-secondary small fw-bold text-uppercase">Room & Identity</div>
                            <div class="mono-cell text-info fw-bold" id="telemetryRoom"></div>
                            <div class="small text-muted" id="telemetryCaller"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-black rounded border border-secondary">
                            <div class="text-secondary small fw-bold text-uppercase">Assigned Agent & Duration</div>
                            <div class="mono-cell text-success fw-bold" id="telemetryAgent"></div>
                            <div class="small text-light" id="telemetryDuration"></div>
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-black rounded border border-secondary">
                    <div class="text-secondary small fw-bold text-uppercase mb-2">Realtime Turn & Audio Metrics</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-primary bg-opacity-20 text-primary border border-primary border-opacity-25">STT: Groq Whisper Turbo (&lt;120ms)</span>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25">LLM: LiteLLM wasid-live (&lt;180ms TTFT)</span>
                        <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25">TTS: Gemini Audio TTS (&lt;150ms)</span>
                        <span class="badge bg-purple bg-opacity-20 text-purple border border-purple border-opacity-25" style="color:#d2a8ff;">VAD: Silero v4</span>
                    </div>
                    <div class="text-secondary small">
                        Audio Sampling: <strong class="text-white">24kHz PCM 16-bit Mono</strong> | LiveKit WebRTC Transport: <strong class="text-success">Active & Healthy</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Embed Canonical Specs for Instant 0ms Client-side Inspection -->
<script id="canonical-specs-data" type="application/json">
{{ fleet.agents_map | tojson | safe }}
</script>

<script>
let specsData = {};
try {
    const raw = document.getElementById('canonical-specs-data').textContent;
    specsData = JSON.parse(raw);
} catch (e) {
    console.error("Failed to parse canonical specs JSON:", e);
}

function switchFleetView(mode) {
    const cards = document.getElementById('fleetCardsView');
    const table = document.getElementById('fleetTableView');
    const btnCards = document.getElementById('btnViewCards');
    const btnTable = document.getElementById('btnViewTable');

    if (mode === 'table') {
        cards.style.display = 'none';
        table.style.display = 'block';
        btnCards.classList.remove('active');
        btnTable.classList.add('active');
    } else {
        cards.style.display = 'grid';
        table.style.display = 'none';
        btnCards.classList.add('active');
        btnTable.classList.remove('active');
    }
}

let currentSpecJson = null;

function openSpecDrawer(agentId) {
    const spec = specsData[agentId] || {};
    currentSpecJson = spec;
    document.getElementById('drawerAgentTitle').textContent = spec.name || agentId;
    document.getElementById('drawerAgentSubtitle').textContent = (spec.id || agentId) + ' | ' + (spec.authoritative_source || 'agent.wasidai.com');

    // Populate Tab 1: Identity
    document.getElementById('dim-id').textContent = spec.id || agentId;
    document.getElementById('dim-role').textContent = spec.role || 'Enterprise Voice Master';
    document.getElementById('dim-persona').textContent = spec.persona_mode || 'CUSTOMER';
    document.getElementById('dim-auth').textContent = spec.authoritative_source || 'agent.wasidai.com (Authoritative)';

    // Tab 2: Instructions
    document.getElementById('dim-instructions').textContent = spec.system_prompt || 'Standard system prompt configured on agent.wasidai.com';

    // Tab 3: Voice
    document.getElementById('dim-voicemode').textContent = spec.voice_mode || 'CASCADE / REALTIME';
    document.getElementById('dim-stt').textContent = spec.stt_engine || 'Groq Whisper Large v3 Turbo (Low Latency)';
    document.getElementById('dim-tts').textContent = spec.tts_engine || 'Google Gemini Flash Audio TTS';
    document.getElementById('dim-vad').textContent = spec.vad_engine || 'Silero VAD v4';

    // Tab 4: Models
    document.getElementById('dim-model').textContent = spec.model || 'wasid-live (LiteLLM)';
    document.getElementById('dim-fallback-model').textContent = spec.fallback_model || 'google/gemini-2.5-flash';
    document.getElementById('dim-gateway').textContent = 'LiteLLM Proxy (High-Availability Quota Pool)';

    // Tab 5: Skills
    const skillsList = document.getElementById('dim-skills-list');
    skillsList.innerHTML = '';
    const skills = spec.skills || ['voice_conversation', 'n8n_integration', 'multilingual_dispatch', 'telemetry_stream', 'intent_routing'];
    skills.forEach(s => {
        const li = document.createElement('li');
        li.className = 'py-1 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2';
        li.innerHTML = '<i class="bi bi-check-circle-fill text-success" style="font-size:0.75rem;"></i> <span class="text-light">' + (s.name || s) + '</span>';
        skillsList.appendChild(li);
    });

    // Tab 6: Tools
    const toolsList = document.getElementById('dim-tools-list');
    toolsList.innerHTML = '';
    const tools = spec.tools || ['get_system_status', 'check_health', 'trigger_n8n_master', 'route_voice_call', 'record_turn_telemetry', 'lookup_customer_catalog'];
    tools.forEach(t => {
        const li = document.createElement('li');
        li.className = 'py-1 border-bottom border-secondary border-opacity-25 d-flex align-items-center gap-2';
        li.innerHTML = '<i class="bi bi-wrench text-info" style="font-size:0.75rem;"></i> <span class="text-light mono-cell">' + (t.name || t) + '</span>';
        toolsList.appendChild(li);
    });

    // Tab 7: MCP
    document.getElementById('dim-mcp-content').innerHTML = '<div class="text-white">LiveKit MCP, Stitch MCP, Coolify MCP registered on host.</div>';

    // Tab 8: Knowledge
    document.getElementById('dim-knowledge-content').innerHTML = '<div class="text-white">Phase 7 Platform Architecture, Canonical Agent Specifications, Service Catalogs.</div>';

    // Tab 9: Memory
    document.getElementById('dim-memory-content').innerHTML = '<div class="text-white">Session Turn Memory, Telemetry Buffers, Realtime LLM Session Context.</div>';

    // Tab 10: Omnichannel
    document.getElementById('dim-omnichannel-content').innerHTML = '<div class="text-white">LiveKit WebRTC Voice, SIP Telephony (Vobiz Carrier), Browser Playground.</div>';

    // Tab 13: Checksum
    document.getElementById('dim-checksum').textContent = spec.spec_hash || 'sha256:f433e61b2386a635...';

    // Show Drawer
    document.getElementById('drawerBackdrop').style.display = 'block';
    document.getElementById('agentSpecDrawer').classList.add('open');
}

function closeSpecDrawer() {
    document.getElementById('drawerBackdrop').style.display = 'none';
    document.getElementById('agentSpecDrawer').classList.remove('open');
}

function copyDrawerJson() {
    if (currentSpecJson) {
        navigator.clipboard.writeText(JSON.stringify(currentSpecJson, null, 2)).then(() => {
            alert("Canonical Spec JSON copied to clipboard!");
        });
    }
}

function showDrawerTab(tabId) {
    document.querySelectorAll('.drawer-tab-content').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.wl-drawer-nav button').forEach(el => el.classList.remove('active'));
    document.getElementById(tabId).style.display = 'block';
    event.target.classList.add('active');
}

function populateDispatchModal(agentName) {
    document.getElementById('manualDispatchAgentSelect').value = agentName;
    document.getElementById('manualDispatchRoomInput').value = 'test-' + agentName + '-' + Math.random().toString(36).substring(2, 7);
    const modal = new bootstrap.Modal(document.getElementById('manualDispatchModal'));
    modal.show();
}

function prepareOutboundCall(agentName) {
    document.getElementById('outboundAgentSelect').value = agentName;
    const modal = new bootstrap.Modal(document.getElementById('outboundCallModal'));
    modal.show();
}

function showSessionTelemetry(room, agent, caller, duration) {
    document.getElementById('telemetryRoom').textContent = room;
    document.getElementById('telemetryCaller').textContent = 'Caller: ' + caller;
    document.getElementById('telemetryAgent').textContent = agent;
    document.getElementById('telemetryDuration').textContent = 'Duration: ' + duration;
    const modal = new bootstrap.Modal(document.getElementById('sessionTelemetryModal'));
    modal.show();
}

// Close drawer on ESC
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeSpecDrawer();
    }
});
</script>
{% endblock %}
