            </div>
        </div>

        <!-- Tab 3: Voice -->
        <div id="tab-voice" class="drawer-tab-content" style="display:none;">
            <div class="spec-dim-card">
                <div class="spec-dim-title"><i class="bi bi-mic"></i> Dimension 3: Voice & Audio Pipeline</div>
                <div class="mb-2"><strong class="text-secondary small">Voice Mode:</strong> <span id="dim-voicemode" class="badge bg-primary"></span></div>
                <div class="mb-2"><strong class="text-secondary small">STT Engine:</strong> <span id="dim-stt" class="text-white"></span></div>
                <div class="mb-2"><strong class="text-secondary small">TTS Engine:</strong> <span id="dim-tts" class="text-white"></span></div>
                <div class="mb-2"><strong class="text-secondary small">VAD Engine:</strong> <span id="dim-vad" class="text-white"></span></div>
                <div class="mb-0"><strong class="text-secondary small">Turn Latency Target:</strong> <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25">&lt; 350ms (Low-Latency Low-Jitter)</span></div>
            </div>
