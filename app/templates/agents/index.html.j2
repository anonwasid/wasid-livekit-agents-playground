                                    <table class="table table-sm table-borderless text-light mb-0" style="font-size:0.85rem;">
                                        <tr><td class="text-muted">Inbound SIP</td><td class="text-light">LiveKit SIP Inbound Dispatch Rules</td></tr>
                                        <tr><td class="text-muted">Outbound SIP</td><td class="text-light">Carrier Trunk SIP Bridge (Opus / G.711)</td></tr>
                                        <tr><td class="text-muted">VAD & Latency</td><td>Silero VAD • 0.5s Endpointing Delay</td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3: Skills & Tools -->
                    <div class="tab-pane fade" id="tab-tools" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-lightning-charge"></i> Dimension 4: Skills</h6>
                                    <ul id="spec-skills-list" class="list-unstyled mb-0 small text-light space-y-1"></ul>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-tools"></i> Dimension 5: Tools</h6>
                                    <div id="spec-tools-list" class="small text-light" style="max-height: 240px; overflow-y:auto;"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-hdd-network"></i> Dimension 6: MCP Servers</h6>
                                    <ul id="spec-mcp-list" class="list-unstyled mb-0 small text-light space-y-1"></ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 4: Omnichannel & Workflows -->
                    <div class="tab-pane fade" id="tab-channels" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-globe"></i> Dimension 9: Omnichannel</h6>
                                    <table class="table table-sm table-borderless text-light mb-0 small">
                                        <tr><td>WebRTC Voice</td><td class="text-success">Active &bull; LiveKit</td></tr>
                                        <tr><td>WhatsApp (OpenWA)</td><td class="text-success">Connected</td></tr>
                                        <tr><td>Telephony (SIP)</td><td class="text-success">Enabled</td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-diagram-3"></i> Dimension 11: n8n Workflows</h6>
                                    <div id="spec-workflows-list" class="small text-light"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-book"></i> Dimension 7: Knowledge Sources</h6>
                                    <div id="spec-knowledge-list" class="small text-light"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 5: Memory & Security -->
                    <div class="tab-pane fade" id="tab-security" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-memory"></i> Dimension 8: Memory Policy</h6>
                                    <table class="table table-sm table-borderless text-light mb-0 small">
                                        <tr><td>Session Retention</td><td class="text-light font-monospace">30 Days</td></tr>
                                        <tr><td>Vector RAG Memory</td><td class="text-success">Qdrant Hybrid Search</td></tr>
                                        <tr><td>Tenant Isolation</td><td class="text-info">Tenant 360 Strict Scope</td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-shield-lock"></i> Dimension 12: Security & RBAC</h6>
                                    <table class="table table-sm table-borderless text-light mb-0 small">
                                        <tr><td>Auth Level</td><td class="text-warning">Bearer + CSRF Token</td></tr>
                                        <tr><td>Allowed Roles</td><td class="text-light">SUPER_ADMIN / TENANT_ADMIN</td></tr>
                                        <tr><td>Data Redaction</td><td class="text-success">Secrets Auto-Redacted</td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stitch-card p-3 h-100">
                                    <h6 class="text-info fw-bold mb-2"><i class="bi bi-tags"></i> Dimension 13: Versioning</h6>
                                    <table class="table table-sm table-borderless text-light mb-0 small">
                                        <tr><td>Spec Version</td><td class="text-info font-monospace">1.0.0 (Production)</td></tr>
                                        <tr><td>Sync State</td><td class="text-success">Synchronized</td></tr>
                                        <tr><td>Parity Target</td><td class="text-light">Zero Drift</td></tr>
