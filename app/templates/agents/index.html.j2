{% extends "base.html.j2" %}

{% block title %}WASID LIVE | Agent Control Center & Voice Telephony{% endblock %}

{% block extra_head %}
<style>
/* WASID LIVE Control Center — Dark Enterprise Theme */
:root {
    --wl-bg: #0d1117;
    --wl-surface: #161b22;
    --wl-surface-subtle: #21262d;
    --wl-border: #30363d;
    --wl-border-bright: #484f58;
    --wl-text-main: #f0f6fc;
    --wl-text-muted: #8b949e;
    --wl-text-subtle: #6e7681;
    --wl-blue: #388bfd;
    --wl-green: #238636;
    --wl-green-text: #3fb950;
    --wl-amber: #d29922;
    --wl-red: #f85149;
    --wl-purple: #a371f7;
}

.wl-container {
    padding-bottom: 3rem;
}

/* Control Header */
.wl-header-bar {
    background: linear-gradient(180deg, #161b22 0%, #11141a 100%);
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
}

.wl-status-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
}

.wl-status-pill {
    background-color: var(--wl-surface-subtle);
    border: 1px solid var(--wl-border);
    color: var(--wl-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}

.wl-status-pill strong {
    color: var(--wl-text-main);
}

.wl-dot-green {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--wl-green-text);
    box-shadow: 0 0 6px rgba(63, 185, 80, 0.4);
}

.wl-dot-blue {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--wl-blue);
}

/* Section Cards */
.wl-card {
    background-color: var(--wl-surface);
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
}

.wl-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--wl-border);
}

.wl-card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--wl-text-main);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

/* Agent Fleet Cards */
.agent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}

.agent-fleet-card {
    background-color: #12161f;
    border: 1px solid var(--wl-border);
    border-radius: 8px;
    padding: 1.25rem;
    position: relative;
    transition: border-color 0.15s ease;
}

.agent-fleet-card:hover {
    border-color: var(--wl-border-bright);
}

.agent-fleet-card.primary-agent {
    border-left: 3px solid var(--wl-blue);
}

.agent-fleet-card.customer-agent {
    border-left: 3px solid var(--wl-purple);
}

.agent-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
}

.agent-id-tag {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--wl-text-main);
}

.agent-role-desc {
    font-size: 0.82rem;
    color: var(--wl-text-muted);
    margin-bottom: 1rem;
    line-height: 1.4;
}

.agent-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
}

.wl-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--wl-border);
    background-color: var(--wl-surface-subtle);
    color: var(--wl-text-muted);
}

.badge-blue {
    background-color: rgba(56, 139, 253, 0.12);
    border-color: rgba(56, 139, 253, 0.3);
    color: #79c0ff;
}

.badge-green {
    background-color: rgba(46, 160, 67, 0.12);
    border-color: rgba(46, 160, 67, 0.3);
    color: #56d364;
}

.badge-purple {
    background-color: rgba(163, 113, 247, 0.12);
    border-color: rgba(163, 113, 247, 0.3);
    color: #d2a8ff;
}

.agent-metric-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background-color: #0b0e14;
    border: 1px solid var(--wl-border);
    border-radius: 6px;
    padding: 0.6rem 0.5rem;
    margin-bottom: 1rem;
    text-align: center;
}

.agent-metric-item {
    padding: 0 0.25rem;
}

.agent-metric-val {
    font-size: 0.95rem;
    font-weight: 700;
    font-family: 'SFMono-Regular', Consolas, monospace;
    color: var(--wl-text-main);
}

.agent-metric-lbl {
    font-size: 0.68rem;
    color: var(--wl-text-subtle);
    text-transform: uppercase;
}

/* Voice Routing Matrix */
.routing-pipeline-diagram {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #0d1117;
    border: 1px solid var(--wl-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
}

.pipeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 110px;
}

.pipeline-step-box {
    background-color: var(--wl-surface-subtle);
    border: 1px solid var(--wl-border);
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--wl-text-main);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.pipeline-step-sub {
    font-size: 0.68rem;
    color: var(--wl-text-subtle);
    margin-top: 0.3rem;
}

.pipeline-arrow {
    color: var(--wl-text-subtle);
    font-size: 1.1rem;
    padding: 0 0.5rem;
}

/* Operational Tables */
.wl-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.82rem;
}

.wl-table th {
    background-color: #12161f;
    color: var(--wl-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--wl-border);
    text-align: left;
}

.wl-table td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid #21262d;
    color: var(--wl-text-main);
    vertical-align: middle;
}

.wl-table tr:hover td {
    background-color: rgba(255, 255, 255, 0.02);
}

.mono-cell {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.78rem;
}

/* Slide-out Drawer (Agent Inspector) */
.wl-drawer-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 1050;
    backdrop-filter: blur(2px);
}

.wl-drawer {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 740px;
    max-width: 95vw;
    background-color: #12161f;
    border-left: 1px solid var(--wl-border);
    z-index: 1060;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
    flex-direction: column;
}

.wl-drawer.open {
    display: flex;
}

.wl-drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--wl-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #161b22;
}

.wl-drawer-nav {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    background-color: #0e1218;
    border-bottom: 1px solid var(--wl-border);
    overflow-x: auto;
}

.wl-drawer-nav button {
    background: none;
    border: none;
    color: var(--wl-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    white-space: nowrap;
    cursor: pointer;
}

.wl-drawer-nav button.active {
    background-color: var(--wl-surface-subtle);
    color: var(--wl-text-main);
    font-weight: 600;
}

.wl-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.5rem;
}

.spec-dim-card {
    background-color: #161b22;
    border: 1px solid var(--wl-border);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 1rem;
}

.spec-dim-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--wl-blue);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}
</style>
{% endblock %}

{% block content %}
<div class="wl-container">

    <!-- Flash Notifications -->
    {% if flash_message %}
    <div class="alert alert-{{ flash_type or 'info' }} alert-dismissible fade show border-0 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="bi {% if flash_type == 'success' %}bi-check-circle-fill{% elif flash_type == 'danger' %}bi-exclamation-triangle-fill{% else %}bi-info-circle-fill{% endif %}"></i>
            <span>{{ flash_message }}</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- 1. Header & System Control Center -->
    <div class="wl-header-bar">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="mb-0 fw-bold text-white">WASID LIVE</h4>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">CONTROL CENTER</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">PHASE 7 VOICE</span>
                </div>
                <div class="text-secondary small">
                    Authoritative sync with <a href="{{ fleet.authoritative_url }}" target="_blank" class="text-decoration-none text-info">{{ fleet.authoritative_source }}</a> | Deterministic SIP routing & dispatch
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form action="/agents/sync" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Sync Fleet</span>
                    </button>
                </form>

                <form action="/agents/provision-vobiz" method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" title="Ensure canonical Vobiz individual dispatch rule is configured">
                        <i class="bi bi-shield-check"></i>
                        <span>Provision Vobiz Rule</span>
                    </button>
                </form>

                <button type="button" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#outboundCallModal">
                    <i class="bi bi-telephone-outbound"></i>
                    <span>New Outbound Call</span>
                </button>

                <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#manualDispatchModal">
                    <i class="bi bi-plus-circle"></i>
                    <span>Manual Dispatch</span>
                </button>
            </div>
        </div>

        <hr class="border-secondary my-3 opacity-25">

        <!-- Operational Status Strip -->
        <div class="wl-status-strip">
            <div class="wl-status-pill">
                <span class="wl-dot-green"></span>
                <span>LiveKit:</span>
                <strong>Connected</strong>
            </div>

            <div class="wl-status-pill">
                <span class="wl-dot-green"></span>
                <span>Workers:</span>
                <strong>{{ fleet.active_workers_summary }}</strong>
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-shield-lock-fill text-success"></i>
                <span>Specification Parity:</span>
                <strong class="text-success">{{ fleet.parity_percentage }} (Zero Drift)</strong>
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-telephone-fill text-info"></i>
                <span>Vobiz Readiness:</span>
                {% if routing_matrix.vobiz_ready %}
                <strong class="text-success">READY (Individual Rule Active)</strong>
                {% else %}
                <strong class="text-warning">Ready to Provision Rule</strong>
                {% endif %}
            </div>

            <div class="wl-status-pill">
                <i class="bi bi-activity text-primary"></i>
                <span>Active Calls:</span>
                <strong>{{ routing_matrix.active_sip_calls }}</strong>
            </div>

            <div class="wl-status-pill ms-auto">
                <i class="bi bi-clock-history"></i>
                <span>Last Synchronized:</span>
                <span>{{ fleet.last_synced_at }}</span>
            </div>
        </div>
    </div>

    <!-- 2. Agent Fleet Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <h5 class="wl-card-title">
                <i class="bi bi-robot text-primary"></i>
                Synchronized Agent Fleet (Canonical Definitions)
            </h5>
            <span class="text-muted small">Target for SIP Routing: <strong class="text-white">{{ routing_matrix.canonical_target_agent }}</strong></span>
        </div>

        <div class="agent-grid">
            <!-- Card 1: wasid-ai-automation-master -->
            <div class="agent-fleet-card primary-agent">
                <div class="agent-header-row">
                    <div>
                        <div class="agent-id-tag">wasid-ai-automation-master</div>
                        <div class="text-info small fw-semibold">WASID AI Automation Master (Canonical Internal)</div>
                    </div>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1">DEFAULT SIP TARGET</span>
                </div>

                <div class="agent-role-desc">
                    Authoritative WASID Master Agent representing the organization's voice automation, system inspection, and platform operations. Built from immutable canonical definition.
                </div>

                <div class="agent-badges">
                    <span class="wl-badge badge-blue">REALTIME / CASCADE</span>
                    <span class="wl-badge badge-green">LiteLLM wasid-live</span>
                    <span class="wl-badge badge-green">Groq Whisper STT</span>
                    <span class="wl-badge badge-blue">Gemini Live + TTS</span>
                    <span class="wl-badge badge-purple">Silero VAD</span>
                    <span class="wl-badge">v1.2.0-prod</span>
                </div>

                <div class="agent-metric-strip">
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">12</div>
                        <div class="agent-metric-lbl">Tools</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">5</div>
                        <div class="agent-metric-lbl">Skills</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">100%</div>
                        <div class="agent-metric-lbl">Parity</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">{{ agent_groups.get('wasid-ai-automation-master', [])|length }}</div>
                        <div class="agent-metric-lbl">Dispatches</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <button type="button" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1" onclick="openSpecDrawer('wasid-ai-automation-master')">
                        <i class="bi bi-layers"></i>
                        <span>Inspect 13 Dimensions</span>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" onclick="populateDispatchModal('wasid-ai-automation-master')">
                        <i class="bi bi-play-circle"></i>
                        <span>Test Dispatch</span>
                    </button>
                </div>
            </div>

            <!-- Card 2: wasid-customer-master -->
            <div class="agent-fleet-card customer-agent">
                <div class="agent-header-row">
                    <div>
                        <div class="agent-id-tag">wasid-customer-master</div>
                        <div class="text-purple small fw-semibold" style="color: #d2a8ff;">WASID Customer Master (Dynamic Multi-Tenant)</div>
                    </div>
                    <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25 px-2 py-1">TENANT BOUND</span>
                </div>

                <div class="agent-role-desc">
                    Dynamic master agent projecting tenant-specific configurations, skills, and business catalogs (e.g. FitZone Gym). Extensible for future customer DID routing.
                </div>

                <div class="agent-badges">
                    <span class="wl-badge badge-purple">CASCADE PIPELINE</span>
                    <span class="wl-badge badge-green">FitZone n8n (Frozen)</span>
                    <span class="wl-badge badge-blue">Gemini TTS</span>
                    <span class="wl-badge badge-purple">Multi-Tenant Context</span>
                    <span class="wl-badge">v1.1.0-prod</span>
                </div>

                <div class="agent-metric-strip">
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">10</div>
                        <div class="agent-metric-lbl">Tools</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">3</div>
                        <div class="agent-metric-lbl">Skills</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">100%</div>
                        <div class="agent-metric-lbl">Parity</div>
                    </div>
                    <div class="agent-metric-item">
                        <div class="agent-metric-val">{{ agent_groups.get('wasid-customer-master', [])|length }}</div>
                        <div class="agent-metric-lbl">Dispatches</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <button type="button" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1" onclick="openSpecDrawer('wasid-customer-master')">
                        <i class="bi bi-layers"></i>
                        <span>Inspect 13 Dimensions</span>
                    </button>

                    <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" onclick="populateDispatchModal('wasid-customer-master')">
                        <i class="bi bi-play-circle"></i>
                        <span>Test Dispatch</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Voice Routing Matrix Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <h5 class="wl-card-title">
                <i class="bi bi-diagram-3 text-success"></i>
                Voice Routing Matrix (SIP Telephony & Agent Dispatch Chain)
            </h5>
            <span class="text-muted small">Guarantee: <strong class="text-success">1 Call = 1 Unique LiveKit Room</strong></span>
        </div>

        <!-- Visual Routing Pipeline Diagram -->
        <div class="routing-pipeline-diagram">
            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-telephone text-primary"></i>
                    <span>Vobiz DID</span>
                </div>
                <div class="pipeline-step-sub">PSTN Ingress</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-hdd-network text-info"></i>
                    <span>Inbound Trunk</span>
                </div>
                <div class="pipeline-step-sub">Auth & IP Filter</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-signpost-split text-warning"></i>
                    <span>Dispatch Rule</span>
                </div>
                <div class="pipeline-step-sub">Individual Rule</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-robot text-purple"></i>
                    <span>Canonical Agent</span>
                </div>
                <div class="pipeline-step-sub">wasid-ai-automation-master</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-door-open text-success"></i>
                    <span>Unique Room</span>
                </div>
                <div class="pipeline-step-sub">sip-in-{caller}_{hash}</div>
            </div>

            <div class="pipeline-arrow"><i class="bi bi-arrow-right"></i></div>

            <div class="pipeline-step">
                <div class="pipeline-step-box">
                    <i class="bi bi-cpu text-info"></i>
                    <span>Worker Session</span>
                </div>
                <div class="pipeline-step-sub">REALTIME / CASCADE</div>
            </div>
        </div>

        <!-- Routing Rules Table -->
        <div class="table-responsive">
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>DID / Phone Number</th>
                        <th>SIP Trunk</th>
                        <th>Dispatch Rule</th>
                        <th>Target Agent</th>
                        <th>Room Strategy</th>
                        <th>Worker Status</th>
                        <th>Routing Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in routing_matrix.routes %}
                    <tr>
                        <td>
                            <span class="badge {% if r.direction == 'INBOUND' %}bg-primary{% else %}bg-info{% endif %} bg-opacity-10 text-{{ 'primary' if r.direction == 'INBOUND' else 'info' }} border border-{{ 'primary' if r.direction == 'INBOUND' else 'info' }} border-opacity-25 px-2 py-1">
                                {{ r.direction }}
                            </span>
                        </td>
                        <td class="mono-cell fw-bold">{{ r.did }}</td>
                        <td>
                            <div>{{ r.trunk_name }}</div>
                            <small class="text-secondary mono-cell">{{ r.trunk_id }}</small>
                        </td>
                        <td>
                            <div>{{ r.rule_name }}</div>
                            <small class="text-secondary mono-cell">{{ r.rule_id }}</small>
                        </td>
                        <td>
                            <span class="badge bg-dark border border-secondary text-white mono-cell px-2 py-1">
                                {{ r.target_agent }}
                            </span>
                        </td>
                        <td class="mono-cell text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            {{ r.room_strategy }}
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                {{ r.worker_status }}
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-success bg-opacity-25 text-success">
                                {{ r.route_status }}
                            </span>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-secondary">
                            <div class="mb-2"><i class="bi bi-info-circle fs-4 text-warning"></i></div>
                            <div>No active SIP routes registered yet.</div>
                            <div class="small text-muted mt-1">Click <strong>"Provision Vobiz Rule"</strong> above to register the canonical individual dispatch rule.</div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. Live Telephony Sessions & Dispatches Section -->
    <div class="wl-card">
        <div class="wl-card-header">
            <h5 class="wl-card-title">
                <i class="bi bi-broadcast text-danger"></i>
                Live Telephony Sessions & Active Dispatches
            </h5>
            <span class="text-muted small">Total Dispatches: <strong class="text-white">{{ total_dispatches }}</strong></span>
        </div>

        {% if telephony_sessions %}
        <div class="table-responsive mb-4">
            <h6 class="text-info small fw-bold text-uppercase mb-2">Active Telephony Calls</h6>
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>Caller Identity</th>
                        <th>DID</th>
                        <th>Agent</th>
                        <th>Room Name</th>
                        <th>Participants</th>
                        <th>Duration</th>
                        <th>Voice Mode</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in telephony_sessions %}
                    <tr>
                        <td>
                            <span class="badge bg-primary bg-opacity-25 text-primary">{{ s.direction }}</span>
                        </td>
                        <td class="mono-cell fw-bold">{{ s.caller }}</td>
                        <td class="mono-cell">{{ s.did }}</td>
                        <td class="mono-cell text-info">{{ s.agent_name }}</td>
                        <td class="mono-cell text-success">{{ s.room_name }}</td>
                        <td>{{ s.num_participants }}</td>
                        <td>{{ s.duration }}</td>
                        <td><span class="badge bg-secondary">{{ s.provider_mode }}</span></td>
                        <td><span class="badge bg-success">{{ s.status }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

        <!-- Agent Dispatches List -->
        <div class="table-responsive">
            <table class="wl-table">
                <thead>
                    <tr>
                        <th>Dispatch ID</th>
                        <th>Agent</th>
                        <th>Room</th>
                        <th>Running Jobs</th>
                        <th>Total Jobs</th>
                        <th>Overall Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for agent_name, dispatches in agent_groups.items() %}
                        {% for d in dispatches %}
                        <tr>
                            <td class="mono-cell">{{ d.id[:16] }}...</td>
                            <td>
                                <span class="badge bg-dark border border-secondary text-white mono-cell px-2 py-1">
                                    {{ d.agent_name }}
                                </span>
                            </td>
                            <td class="mono-cell text-info">{{ d.room }}</td>
                            <td>
                                {% if d.running_jobs > 0 %}
                                <span class="badge bg-success bg-opacity-25 text-success">{{ d.running_jobs }} running</span>
                                {% else %}
                                <span class="text-secondary">0</span>
                                {% endif %}
                            </td>
                            <td>{{ d.total_jobs }}</td>
                            <td>
                                {% if d.status == 'running' %}
                                <span class="badge bg-success">RUNNING</span>
                                {% else %}
                                <span class="badge bg-secondary">PENDING</span>
                                {% endif %}
                            </td>
                            <td class="small text-secondary">{{ d.created_at or '—' }}</td>
                            <td class="text-end">
                                <form action="/agents/{{ d.id }}/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this dispatch?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="room" value="{{ d.room }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-secondary">
                            No agent dispatches active currently.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

