{% extends "base.html.j2" %}

{% block title %}Call Recordings & Egress - LiveKit Dashboard{% endblock %}

{% block page_title %}Call Recordings{% endblock %}

{% block page_subtitle %}
<p class="page-subtitle">Automatic Cloudflare R2 Call Recordings & LiveKit Egress Jobs</p>
{% endblock %}

{% block content %}
<!-- Live Pulse CSS -->
<style>
@keyframes pulse-red {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}
.badge-recording {
    background-color: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid #ef4444;
    animation: pulse-red 2s infinite;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}
.badge-inbound {
    background-color: rgba(6, 182, 212, 0.15);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.3);
}
.badge-outbound {
    background-color: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    border: 1px solid rgba(168, 85, 247, 0.3);
}
.custom-audio-player {
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    user-select: none;
}
.custom-audio-player.is-playing {
    border-color: rgba(59, 130, 246, 0.6) !important;
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.25);
}
.audio-scrubber {
    accent-color: #3b82f6;
}
.audio-scrubber::-webkit-slider-thumb {
    width: 11px;
    height: 11px;
}
.audio-scrubber::-moz-range-thumb {
    width: 11px;
    height: 11px;
}
</style>

<!-- Stats Grid -->
<div class="stats-grid mb-4">
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-disc text-primary"></i> Total Recordings
        </div>
        <div class="stat-value info">
            {{ stats.total_recordings }}
        </div>
        <small class="text-muted">Stored in Cloudflare R2</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-telephone-inbound text-info"></i> Inbound / Outbound
        </div>
        <div class="stat-value">
            <span class="text-info">{{ stats.inbound_recordings }}</span>
            <span class="text-muted" style="font-size: 1.25rem;"> / </span>
            <span style="color: #a855f7;">{{ stats.outbound_recordings }}</span>
        </div>
        <small class="text-muted">Total conversations</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-clock-history text-warning"></i> Recorded Audio
        </div>
        <div class="stat-value warning">
            {% if stats.total_duration_seconds >= 3600 %}
                {{ (stats.total_duration_seconds / 3600) | round(1) }}h
            {% elif stats.total_duration_seconds >= 60 %}
                {{ (stats.total_duration_seconds / 60) | round(1) }}m
            {% else %}
                {{ stats.total_duration_seconds }}s
            {% endif %}
        </div>
        <small class="text-muted">{{ stats.total_duration_seconds }} total seconds</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-cloud-check text-success"></i> R2 Storage Used
        </div>
        <div class="stat-value success">
            {% if stats.total_file_size_bytes >= 1073741824 %}
                {{ (stats.total_file_size_bytes / 1073741824) | round(2) }} GB
            {% elif stats.total_file_size_bytes >= 1048576 %}
                {{ (stats.total_file_size_bytes / 1048576) | round(2) }} MB
            {% else %}
                {{ (stats.total_file_size_bytes / 1024) | round(1) }} KB
            {% endif %}
        </div>
        <small class="text-muted">Direct Cloudflare R2 Storage</small>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" action="/egress" class="row g-2 align-items-center">
            <div class="col-12 col-md-3 col-xl-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search phone, room, ID..." value="{{ search_query }}">
                </div>
            </div>

            <div class="col-6 col-md-2 col-xl-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-arrows-expand"></i></span>
                    <select name="direction" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_direction == 'all' %}selected{% endif %}>All Directions</option>
                        <option value="inbound" {% if selected_direction == 'inbound' %}selected{% endif %}>Inbound (↓)</option>
                        <option value="outbound" {% if selected_direction == 'outbound' %}selected{% endif %}>Outbound (↑)</option>
                    </select>
                </div>
            </div>

            <div class="col-6 col-md-2 col-xl-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_status == 'all' %}selected{% endif %}>All Statuses</option>
                        <option value="completed" {% if selected_status == 'completed' %}selected{% endif %}>Completed</option>
                        <option value="recording" {% if selected_status == 'recording' %}selected{% endif %}>Recording</option>
                        <option value="failed" {% if selected_status == 'failed' %}selected{% endif %}>Failed</option>
                    </select>
                </div>
            </div>

            <div class="col-6 col-md-2 col-xl-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-building"></i></span>
                    <select name="tenant" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_tenant == 'all' %}selected{% endif %}>All Tenants</option>
                        {% for t in distinct_tenants %}
                        <option value="{{ t }}" {% if selected_tenant == t %}selected{% endif %}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                    <select name="did" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_did == 'all' %}selected{% endif %}>All DIDs</option>
                        {% for d in distinct_dids %}
                        <option value="{{ d }}" {% if selected_did == d %}selected{% endif %}>{{ d }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="col-12 col-xl-2 d-flex gap-2 justify-content-between justify-content-xl-end flex-wrap">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-secondary btn-sm" title="Apply Filter">
                        <i class="bi bi-filter"></i> Apply
                    </button>
                    <a href="/egress" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#startEgressModal">
                    <i class="bi bi-plus-circle"></i> Egress
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Persistent Call Recordings Table -->
<div class="card mb-4" id="recordings-card" hx-get="/egress" hx-trigger="every 10s" hx-select="#recordings-table-body" hx-target="#recordings-table-body" hx-swap="outerHTML">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">
            <i class="bi bi-music-note-list text-primary me-2"></i> Voice Call Recordings
        </h5>
        <span class="badge bg-secondary">Auto-syncing every 10s</span>
    </div>
    <div class="card-body p-0">
        {% if recordings %}
        <div class="table-container">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tenant</th>
                        <th>Direction</th>
                        <th>Caller (From)</th>
                        <th>Receiver (To)</th>
                        <th>Agent / Room</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Recording Player</th>
                        <th>AI Transcript</th>
                        <th>Started</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="recordings-table-body">
                    {% for rec in recordings %}
                    <tr>
                        <td>
                            {% if rec.tenant_id == 'ADMIN' or not rec.tenant_id %}
                            <span class="badge" style="background-color: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); font-weight: 600;">ADMIN</span>
                            {% else %}
                            <span class="badge" style="background-color: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 600;">{{ rec.tenant_id }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.direction == 'inbound' %}
                            <span class="badge badge-inbound"><i class="bi bi-arrow-down-left"></i> Inbound</span>
                            {% else %}
                            <span class="badge badge-outbound"><i class="bi bi-arrow-up-right"></i> Outbound</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <i class="bi bi-telephone-outbound text-primary" style="font-size: 0.85rem;"></i>
                                <span class="font-monospace fw-semibold" style="color: var(--text-primary); font-size: 0.85rem;">
                                    {% if rec.direction == 'inbound' %}
                                        {{ rec.caller_number or 'Inbound Caller' }}
                                    {% else %}
                                        {{ rec.caller_number or rec.did_number or '+918065355408' }}
                                    {% endif %}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <i class="bi bi-telephone-inbound text-info" style="font-size: 0.85rem;"></i>
                                <span class="font-monospace text-muted" style="font-size: 0.85rem;">
                                    {% if rec.direction == 'inbound' %}
                                        {{ rec.callee_number or rec.did_number or '+918065355408' }}
                                    {% else %}
                                        {{ rec.callee_number or 'Outbound Recipient' }}
                                    {% endif %}
                                </span>
                            </div>
                        </td>
                        <td>
                            <div style="font-size: 0.8125rem;">
                                <span class="badge bg-dark text-light">{{ rec.agent_id or 'wasid-ai-automation-master' }}</span>
                            </div>
                            <small class="text-muted font-monospace" style="font-size: 0.75rem;">{{ rec.room_name }}</small>
                        </td>
                        <td>
                            {% if rec.status == 'recording' %}
                            <span class="badge badge-recording"><i class="bi bi-record-fill"></i> RECORDING</span>
                            {% elif rec.status == 'completed' %}
                            <span class="badge badge-success"><i class="bi bi-check-circle"></i> Completed</span>
                            {% elif rec.status == 'failed' %}
                            <span class="badge badge-danger" title="{{ rec.error_message or 'Error' }}"><i class="bi bi-exclamation-triangle"></i> Failed</span>
                            {% else %}
                            <span class="badge badge-warning">{{ rec.status }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.duration_seconds > 0 %}
                            <span style="font-weight: 500;">
                                {{ (rec.duration_seconds // 60) }}:{{ "%02d"|format(rec.duration_seconds % 60) }}
                            </span>
                            {% else %}
                            <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.status == 'completed' and rec.storage_object_key %}
                            <div class="custom-audio-player d-flex align-items-center gap-2 p-1 px-2 rounded" 
                                 data-recording-id="{{ rec.recording_id }}" 
                                 data-duration="{{ rec.duration_seconds }}"
                                 style="background: var(--bg-tertiary, #1e293b); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); min-width: 210px; max-width: 250px;">
                                <audio class="d-none" preload="none" src="/egress/{{ rec.recording_id }}/stream"></audio>
                                <button type="button" class="btn btn-sm btn-primary rounded-circle p-0 audio-play-btn d-flex align-items-center justify-content-center" 
                                        style="width: 30px; height: 30px; flex-shrink: 0;" title="Play Audio">
                                    <i class="bi bi-play-fill" style="font-size: 1.1rem; margin-left: 2px;"></i>
                                </button>
                                <div class="flex-grow-1 d-flex flex-column justify-content-center" style="min-width: 0;">
                                    <input type="range" class="form-range audio-scrubber" min="0" max="100" value="0" step="0.1" 
                                           style="height: 5px; cursor: pointer; margin-bottom: 2px;" aria-label="Seek">
                                    <div class="d-flex justify-content-between align-items-center" style="font-size: 0.72rem; line-height: 1;">
                                        <span class="audio-current-time font-monospace" style="color: var(--text-primary, #f8fafc);">0:00</span>
                                        <span class="text-muted mx-1">/</span>
                                        <span class="audio-total-time font-monospace text-muted">
                                            {% if rec.duration_seconds > 0 %}
                                                {{ (rec.duration_seconds // 60) }}:{{ "%02d"|format(rec.duration_seconds % 60) }}
                                            {% else %}
                                                0:00
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            {% elif rec.status == 'recording' %}
                            <small class="text-danger"><i class="bi bi-broadcast"></i> Live in progress...</small>
                            {% else %}
                            <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td id="transcript-cell-{{ rec.recording_id }}">
                            {% if rec.transcription %}
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-info view-transcript-btn d-flex align-items-center gap-1 py-0 px-2"
                                        style="height: 28px; font-size: 0.78rem;"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#transcriptModal"
                                        data-recording-id="{{ rec.recording_id }}"
                                        data-tenant="{{ rec.tenant_id or 'ADMIN' }}"
                                        data-caller="{% if rec.direction == 'inbound' %}{{ rec.caller_number or 'Inbound Caller' }}{% else %}{{ rec.caller_number or rec.did_number or '+918065355408' }}{% endif %}"
                                        data-callee="{% if rec.direction == 'inbound' %}{{ rec.callee_number or rec.did_number or '+918065355408' }}{% else %}{{ rec.callee_number or 'Outbound Recipient' }}{% endif %}"
                                        data-direction="{{ (rec.direction or 'call') | upper }}"
                                        data-started="{{ rec.started_at[:19].replace('T', ' ') if rec.started_at else '-' }}"
                                        data-duration="{% if rec.duration_seconds > 0 %}{{ (rec.duration_seconds // 60) }}:{{ '%02d'|format(rec.duration_seconds % 60) }}{% else %}0:00{% endif %}"
                                        data-transcript="{{ rec.transcription | e }}"
                                        title="View Gemini AI Transcript">
                                    <i class="bi bi-file-earmark-text"></i> View
                                </button>
                                <a href="/egress/{{ rec.recording_id }}/transcript/download" 
                                   class="btn btn-sm btn-outline-secondary py-0 px-2" 
                                   style="height: 28px; font-size: 0.78rem;"
                                   title="Download Transcript as Text File (.txt)">
                                    <i class="bi bi-download"></i> .txt
                                </a>
                            </div>
                            {% elif rec.transcription_status == 'transcribing' %}
                            <div class="d-inline-flex align-items-center gap-1">
                                <span class="badge bg-warning-subtle text-warning border border-warning d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                    <span class="spinner-border spinner-border-sm" style="width: 0.7rem; height: 0.7rem;"></span> Transcribing...
                                </span>
                                <button type="button" class="btn btn-sm btn-link p-0 text-muted" onclick="triggerTranscribe('{{ rec.recording_id }}', this)" title="Force Retry" style="font-size: 0.75rem;">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            {% elif rec.transcription_status == 'failed' and rec.status == 'completed' %}
                            <button type="button" 
                                    class="btn btn-sm btn-outline-warning py-0 px-2 trigger-transcribe-btn d-flex align-items-center gap-1"
                                    style="height: 28px; font-size: 0.75rem;"
                                    onclick="triggerTranscribe('{{ rec.recording_id }}', this)"
                                    title="Retry Gemini AI Transcript">
                                <i class="bi bi-arrow-clockwise text-warning"></i> Retry
                            </button>
                            {% elif rec.status == 'completed' %}
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary py-0 px-2 trigger-transcribe-btn d-flex align-items-center gap-1"
                                    style="height: 28px; font-size: 0.75rem;"
                                    onclick="triggerTranscribe('{{ rec.recording_id }}', this)"
                                    title="Generate AI Transcript with Google Gemini 3.5 Transcribe Live">
                                <i class="bi bi-stars text-warning"></i> Transcribe
                            </button>
                            {% else %}
                            <span class="text-muted" style="font-size: 0.8rem;">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <small class="text-muted">{{ rec.started_at[:19].replace('T', ' ') if rec.started_at else '-' }}</small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                {% if rec.status == 'completed' and rec.storage_object_key %}
                                <a href="/egress/{{ rec.recording_id }}/download" class="btn btn-outline-primary" title="Download Standard MP3 Recording">
                                    <i class="bi bi-download"></i> <span class="d-none d-sm-inline ms-1 font-monospace" style="font-size: 0.75rem;">MP3</span>
                                </a>
                                {% endif %}
                                <form method="post" action="/egress/{{ rec.recording_id }}/delete" style="display: inline;" onsubmit="return confirm('Permanently delete this recording from Cloudflare R2?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-outline-danger" title="Delete Recording">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="empty-state p-5 text-center">
            <div class="empty-state-icon mb-3">
                <i class="bi bi-mic text-muted" style="font-size: 3rem;"></i>
            </div>
            <h5 class="empty-state-title">No recordings found</h5>
            <p class="empty-state-description text-muted">
                Every inbound call to Vobiz DID (+918065355408) and every outbound conversation is automatically recorded to Cloudflare R2 and will appear here.
            </p>
        </div>
        {% endif %}
    </div>
</div>

<!-- Active LiveKit Egress Worker Jobs -->
{% if active_egress_jobs %}
<div class="card mb-4 border-warning">
    <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0 text-warning-emphasis">
            <i class="bi bi-activity me-2"></i> Active LiveKit Worker Jobs ({{ active_egress_jobs|length }})
        </h6>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Egress ID</th>
                        <th>Room Name</th>
                        <th>Status</th>
                        <th>Started At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in active_egress_jobs %}
                    <tr>
                        <td><code>{{ job.egress_id[:16] }}...</code></td>
                        <td><strong>{{ job.room_name or '-' }}</strong></td>
                        <td><span class="badge badge-recording">{{ job.status }}</span></td>
                        <td><small>{{ job.started_at }}</small></td>
                        <td>
                            <form method="post" action="/egress/{{ job.egress_id }}/stop" style="display: inline;" onsubmit="return confirm('Stop this active egress worker?');">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-stop-circle"></i> Stop
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}

<!-- Start Manual Egress Modal -->
<div class="modal fade" id="startEgressModal" tabindex="-1" aria-labelledby="startEgressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="startEgressModalLabel">Manual Egress Recording</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/egress/start">
                <div class="modal-body">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <div class="form-group mb-3">
                        <label class="form-label">Room Name *</label>
                        <input type="text" class="form-control" name="room_name" placeholder="e.g. sip-in-..." required>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Output Filename *</label>
                        <input type="text" class="form-control" name="output_filename" placeholder="manual-{room}-{time}.m4a" required>
                        <small class="text-muted">Saved directly into Cloudflare R2 storage</small>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Layout</label>
                        <select class="form-select" name="layout">
                            <option value="grid" selected>Grid</option>
                            <option value="speaker">Speaker</option>
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="audio_only" id="audio_only" checked>
                        <label class="form-check-label" for="audio_only">Audio Only (Optimized for Telephone Calls)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-record-circle"></i> Start Recording</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Gemini 3.5 AI Transcript Modal -->
<div class="modal fade" id="transcriptModal" tabindex="-1" aria-labelledby="transcriptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: var(--bg-secondary, #111827); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); color: var(--text-primary, #f8fafc);">
            <div class="modal-header border-secondary border-opacity-25 pb-2">
                <div>
                    <h5 class="modal-title d-flex align-items-center gap-2 mb-0" id="transcriptModalLabel">
                        <i class="bi bi-stars text-warning"></i> Call AI Transcript
                        <span class="badge" style="background-color: rgba(59, 130, 246, 0.2); color: #60a5fa; font-size: 0.72rem; font-weight: normal;">
                            Google Gemini 3.5 Transcribe Live
                        </span>
                    </h5>
                    <small class="text-muted" id="modal-subtitle">Recording ID</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-3">
                <!-- Metadata strip -->
                <div class="p-2 mb-3 rounded" style="background: var(--bg-tertiary, #1e293b); font-size: 0.82rem; border: 1px solid rgba(255,255,255,0.05);">
                    <div class="row g-2">
                        <div class="col-6 col-sm-3">
                            <span class="text-muted">Tenant:</span>
                            <span id="modal-tenant" class="fw-semibold ms-1 text-primary">ADMIN</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted">Direction:</span>
                            <span id="modal-direction" class="fw-semibold ms-1">INBOUND</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted">Caller:</span>
                            <span id="modal-caller" class="font-monospace ms-1 text-info">+918009128306</span>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted">Duration:</span>
                            <span id="modal-duration" class="font-monospace ms-1">0:27</span>
                        </div>
                    </div>
                </div>

                <div class="position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label text-muted small mb-0">STT Transcription Text (SMART Mode):</label>
                        <span class="badge bg-secondary" style="font-size: 0.7rem;">Raw 16kHz PCM Streamed</span>
                    </div>
                    <div id="modal-transcript-text" 
                         class="p-3 rounded font-monospace" 
                         style="background: #0f172a; border: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem; line-height: 1.6; min-height: 140px; max-height: 380px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;">
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary border-opacity-25 pt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="copyModalTranscript()">
                    <i class="bi bi-clipboard"></i> <span id="copy-btn-text">Copy Text</span>
                </button>
                <a id="modal-download-btn" href="#" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-download"></i> Download .txt
                </a>
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
// Handle Transcript Modal Display
document.addEventListener('DOMContentLoaded', function() {
    const transcriptModal = document.getElementById('transcriptModal');
    if (transcriptModal) {
        transcriptModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            if (!button) return;

            const recId = button.getAttribute('data-recording-id') || '';
            const tenant = button.getAttribute('data-tenant') || 'ADMIN';
            const caller = button.getAttribute('data-caller') || '-';
            const callee = button.getAttribute('data-callee') || '-';
            const direction = button.getAttribute('data-direction') || 'CALL';
            const duration = button.getAttribute('data-duration') || '0:00';
            const transcript = button.getAttribute('data-transcript') || '';

            document.getElementById('modal-subtitle').textContent = recId;
            document.getElementById('modal-tenant').textContent = tenant;
            document.getElementById('modal-direction').textContent = direction;
            document.getElementById('modal-caller').textContent = caller;
            document.getElementById('modal-duration').textContent = duration;
            document.getElementById('modal-transcript-text').textContent = transcript || 'No transcription available.';

            const downloadBtn = document.getElementById('modal-download-btn');
            if (downloadBtn) {
                downloadBtn.href = '/egress/' + encodeURIComponent(recId) + '/transcript/download';
            }
        });
    }
});

function copyModalTranscript() {
    const textEl = document.getElementById('modal-transcript-text');
    if (!textEl) return;
    const text = textEl.textContent || '';
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
            const btnText = document.getElementById('copy-btn-text');
            if (btnText) {
                btnText.textContent = 'Copied!';
                setTimeout(() => { btnText.textContent = 'Copy Text'; }, 1500);
            }
        });
    }
}

async function triggerTranscribe(recordingId, btn) {
    if (!recordingId || !btn) return;
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Transcribing...';

    // Immediately update cell content to show spinner
    const cell = document.getElementById(`transcript-cell-${recordingId}`);
    if (cell) {
        cell.innerHTML = `<span class="badge bg-warning-subtle text-warning border border-warning d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;"><span class="spinner-border spinner-border-sm" style="width: 0.7rem; height: 0.7rem;"></span> Transcribing...</span>`;
    }

    try {
        const resp = await fetch('/egress/' + encodeURIComponent(recordingId) + '/transcribe', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
        if (resp.ok) {
            startPollingTranscription(recordingId, btn);
        } else {
            alert('Transcription failed to start. Please check the logs.');
            if (cell) cell.innerHTML = origHtml;
        }
    } catch (e) {
        console.error('Transcribe error:', e);
        alert('Network error while requesting transcription.');
        if (cell) cell.innerHTML = origHtml;
    }
}

function startPollingTranscription(recordingId, btn) {
    const pollInterval = 3000; // 3 seconds
    const maxAttempts = 80; // stop after 4 minutes for long calls
    let attempts = 0;
    const intervalId = setInterval(async () => {
        attempts++;
        try {
            const resp = await fetch('/egress/' + encodeURIComponent(recordingId) + '/transcript');
            if (!resp.ok) {
                console.warn('Failed to fetch transcript status');
                return;
            }
            const data = await resp.json();
            if (data.transcription_status === 'completed') {
                const cell = document.getElementById(`transcript-cell-${recordingId}`);
                if (cell) {
                    const transcriptEscaped = data.transcription ? data.transcription.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '';
                    const callerNum = data.caller_number || '';
                    const calleeNum = data.callee_number || '';
                    const dir = (data.direction || '').toUpperCase();
                    const startedAt = data.started_at ? data.started_at.substring(0, 19).replace('T', ' ') : '-';
                    const durSec = data.duration_seconds || 0;
                    const durStr = Math.floor(durSec / 60) + ':' + String(durSec % 60).padStart(2, '0');
                    const viewBtnHtml = `<button type="button" class="btn btn-sm btn-outline-info view-transcript-btn d-flex align-items-center gap-1 py-0 px-2" style="height: 28px; font-size: 0.78rem;" data-bs-toggle="modal" data-bs-target="#transcriptModal" data-recording-id="${recordingId}" data-tenant="${data.tenant_id || 'ADMIN'}" data-caller="${callerNum}" data-callee="${calleeNum}" data-direction="${dir}" data-started="${startedAt}" data-duration="${durStr}" data-transcript="${transcriptEscaped}" title="View Gemini AI Transcript"><i class="bi bi-file-earmark-text"></i> View</button>`;
                    const downloadBtnHtml = `<a href="/egress/${encodeURIComponent(recordingId)}/transcript/download" class="btn btn-sm btn-outline-secondary py-0 px-2" style="height: 28px; font-size: 0.78rem;" title="Download Transcript as Text File (.txt)"><i class="bi bi-download"></i> .txt</a>`;
                    cell.innerHTML = `<div class="d-flex align-items-center gap-1">${viewBtnHtml}${downloadBtnHtml}</div>`;
                }
                clearInterval(intervalId);
                return;
            } else if (data.transcription_status === 'failed') {
                const cell = document.getElementById(`transcript-cell-${recordingId}`);
                if (cell) {
                    cell.innerHTML = `<button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 trigger-transcribe-btn d-flex align-items-center gap-1" style="height: 28px; font-size: 0.75rem;" onclick="triggerTranscribe('${recordingId}', this)" title="Retry Gemini AI Transcript"><i class="bi bi-arrow-clockwise text-warning"></i> Retry</button>`;
                }
                clearInterval(intervalId);
                return;
            }
            // Still transcribing — check timeout
            if (attempts >= maxAttempts) {
                clearInterval(intervalId);
                const cell = document.getElementById(`transcript-cell-${recordingId}`);
                if (cell) {
                    cell.innerHTML = `<button type="button" class="btn btn-sm btn-outline-warning py-0 px-2 trigger-transcribe-btn d-flex align-items-center gap-1" style="height: 28px; font-size: 0.75rem;" onclick="triggerTranscribe('${recordingId}', this)" title="Retry Gemini AI Transcript"><i class="bi bi-arrow-clockwise text-warning"></i> Retry</button>`;
                }
            }
        } catch (e) {
            console.error('Polling error:', e);
        }
    }, pollInterval);
}

// Auto-poll for recordings already in "transcribing" state on page load
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('td[id^="transcript-cell-"]').forEach(function(cell) {
        const spinner = cell.querySelector('.spinner-border');
        if (spinner) {
            const recordingId = cell.id.replace('transcript-cell-', '');
            if (recordingId) {
                startPollingTranscription(recordingId, null);
            }
        }
    });
});
</script>
{% endblock %}
