{% extends "base.html.j2" %}

{% block title %}Call Recordings & Egress - LiveKit Dashboard{% endblock %}

{% block page_title %}Call Recordings{% endblock %}

{% block page_subtitle %}
<p class="page-subtitle">Automatic Cloudflare R2 Call Recordings & LiveKit Egress Jobs</p>
{% endblock %}

{% block content %}
<!-- Live Pulse CSS -->
<style>
@keyframes pulse-red {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
}
.badge-recording {
    background-color: rgba(239, 68, 68, 0.2);
    color: #ef4444;
    border: 1px solid #ef4444;
    animation: pulse-red 2s infinite;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}
.badge-inbound {
    background-color: rgba(6, 182, 212, 0.15);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.3);
}
.badge-outbound {
    background-color: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    border: 1px solid rgba(168, 85, 247, 0.3);
}
.audio-player-container audio {
    height: 32px;
    max-width: 220px;
    border-radius: 16px;
    outline: none;
}
audio::-webkit-media-controls-panel {
    background-color: var(--bg-tertiary, #1e293b);
}
audio::-webkit-media-controls-current-time-display,
audio::-webkit-media-controls-time-remaining-display {
    color: #f8fafc;
}
</style>

<!-- Stats Grid -->
<div class="stats-grid mb-4" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-disc text-primary"></i> Total Recordings
        </div>
        <div class="stat-value info">
            {{ stats.total_recordings }}
        </div>
        <small class="text-muted">Stored in Cloudflare R2</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-telephone-inbound text-info"></i> Inbound / Outbound
        </div>
        <div class="stat-value">
            <span class="text-info">{{ stats.inbound_recordings }}</span>
            <span class="text-muted" style="font-size: 1.25rem;"> / </span>
            <span style="color: #a855f7;">{{ stats.outbound_recordings }}</span>
        </div>
        <small class="text-muted">Total conversations</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-clock-history text-warning"></i> Recorded Audio
        </div>
        <div class="stat-value warning">
            {% if stats.total_duration_seconds >= 3600 %}
                {{ (stats.total_duration_seconds / 3600) | round(1) }}h
            {% elif stats.total_duration_seconds >= 60 %}
                {{ (stats.total_duration_seconds / 60) | round(1) }}m
            {% else %}
                {{ stats.total_duration_seconds }}s
            {% endif %}
        </div>
        <small class="text-muted">{{ stats.total_duration_seconds }} total seconds</small>
    </div>

    <div class="stat-card">
        <div class="stat-label">
            <i class="bi bi-cloud-check text-success"></i> R2 Storage Used
        </div>
        <div class="stat-value success">
            {% if stats.total_file_size_bytes >= 1073741824 %}
                {{ (stats.total_file_size_bytes / 1073741824) | round(2) }} GB
            {% elif stats.total_file_size_bytes >= 1048576 %}
                {{ (stats.total_file_size_bytes / 1048576) | round(2) }} MB
            {% else %}
                {{ (stats.total_file_size_bytes / 1024) | round(1) }} KB
            {% endif %}
        </div>
        <small class="text-muted">Bucket: wasid-voice-recordings</small>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" action="/egress" class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search phone, room, ID..." value="{{ search_query }}">
                </div>
            </div>

            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-arrows-expand"></i></span>
                    <select name="direction" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_direction == 'all' %}selected{% endif %}>All Directions</option>
                        <option value="inbound" {% if selected_direction == 'inbound' %}selected{% endif %}>Inbound (↓)</option>
                        <option value="outbound" {% if selected_direction == 'outbound' %}selected{% endif %}>Outbound (↑)</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="all" {% if selected_status == 'all' %}selected{% endif %}>All Statuses</option>
                        <option value="completed" {% if selected_status == 'completed' %}selected{% endif %}>Completed</option>
                        <option value="recording" {% if selected_status == 'recording' %}selected{% endif %}>Recording</option>
                        <option value="failed" {% if selected_status == 'failed' %}selected{% endif %}>Failed</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3 d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-secondary btn-sm">
                    <i class="bi bi-filter"></i> Apply
                </button>
                <a href="/egress" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                    <i class="bi bi-x-circle"></i> Reset
                </a>
                <button type="button" class="btn btn-primary btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#startEgressModal">
                    <i class="bi bi-plus-circle"></i> Start Egress
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Persistent Call Recordings Table -->
<div class="card mb-4" id="recordings-card" hx-get="/egress" hx-trigger="every 10s" hx-select="#recordings-table-body" hx-target="#recordings-table-body" hx-swap="outerHTML">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">
            <i class="bi bi-music-note-list text-primary me-2"></i> Voice Call Recordings
        </h5>
        <span class="badge bg-secondary">Auto-syncing every 10s</span>
    </div>
    <div class="card-body p-0">
        {% if recordings %}
        <div class="table-container">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Direction</th>
                        <th>Phone / DID</th>
                        <th>Agent / Room</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Size</th>
                        <th>Listen</th>
                        <th>Started</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="recordings-table-body">
                    {% for rec in recordings %}
                    <tr>
                        <td>
                            {% if rec.direction == 'inbound' %}
                            <span class="badge badge-inbound"><i class="bi bi-arrow-down-left"></i> Inbound</span>
                            {% else %}
                            <span class="badge badge-outbound"><i class="bi bi-arrow-up-right"></i> Outbound</span>
                            {% endif %}
                        </td>
                        <td>
                            <div>
                                <strong style="color: var(--text-primary);">{{ rec.caller_number or 'Inbound Caller' }}</strong>
                                {% if rec.callee_number %}
                                <span class="text-muted mx-1">→</span>
                                <small class="text-muted">{{ rec.callee_number }}</small>
                                {% endif %}
                            </div>
                            {% if rec.did_number %}
                            <small class="text-muted"><i class="bi bi-telephone"></i> {{ rec.did_number }}</small>
                            {% endif %}
                        </td>
                        <td>
                            <div style="font-size: 0.8125rem;">
                                <span class="badge bg-dark text-light">{{ rec.agent_id or 'wasid-ai-automation-master' }}</span>
                            </div>
                            <small class="text-muted font-monospace" style="font-size: 0.75rem;">{{ rec.room_name }}</small>
                        </td>
                        <td>
                            {% if rec.status == 'recording' %}
                            <span class="badge badge-recording"><i class="bi bi-record-fill"></i> RECORDING</span>
                            {% elif rec.status == 'completed' %}
                            <span class="badge badge-success"><i class="bi bi-check-circle"></i> Completed</span>
                            {% elif rec.status == 'failed' %}
                            <span class="badge badge-danger" title="{{ rec.error_message or 'Error' }}"><i class="bi bi-exclamation-triangle"></i> Failed</span>
                            {% else %}
                            <span class="badge badge-warning">{{ rec.status }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.duration_seconds > 0 %}
                            <span style="font-weight: 500;">
                                {{ (rec.duration_seconds // 60) }}:{{ "%02d"|format(rec.duration_seconds % 60) }}
                            </span>
                            {% else %}
                            <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.file_size_bytes > 0 %}
                            <small class="text-muted">{{ (rec.file_size_bytes / 1024) | round(0) }} KB</small>
                            {% else %}
                            <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if rec.status == 'completed' and rec.storage_object_key %}
                            <div class="audio-player-container">
                                <audio controls preload="none" src="/egress/{{ rec.recording_id }}/stream"></audio>
                            </div>
                            {% elif rec.status == 'recording' %}
                            <small class="text-danger"><i class="bi bi-broadcast"></i> Live in progress...</small>
                            {% else %}
                            <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <small class="text-muted">{{ rec.started_at[:19].replace('T', ' ') if rec.started_at else '-' }}</small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                {% if rec.status == 'completed' and rec.storage_object_key %}
                                <a href="/egress/{{ rec.recording_id }}/download" class="btn btn-outline-primary" title="Download Recording">
                                    <i class="bi bi-download"></i>
                                </a>
                                {% endif %}
                                <form method="post" action="/egress/{{ rec.recording_id }}/delete" style="display: inline;" onsubmit="return confirm('Permanently delete this recording from Cloudflare R2?');">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-outline-danger" title="Delete Recording">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div class="empty-state p-5 text-center">
            <div class="empty-state-icon mb-3">
                <i class="bi bi-mic text-muted" style="font-size: 3rem;"></i>
            </div>
            <h5 class="empty-state-title">No recordings found</h5>
            <p class="empty-state-description text-muted">
                Every inbound call to Vobiz DID (+918065355408) and every outbound conversation is automatically recorded to Cloudflare R2 and will appear here.
            </p>
        </div>
        {% endif %}
    </div>
</div>

<!-- Active LiveKit Egress Worker Jobs -->
{% if active_egress_jobs %}
<div class="card mb-4 border-warning">
    <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
        <h6 class="card-title mb-0 text-warning-emphasis">
            <i class="bi bi-activity me-2"></i> Active LiveKit Worker Jobs ({{ active_egress_jobs|length }})
        </h6>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Egress ID</th>
                        <th>Room Name</th>
                        <th>Status</th>
                        <th>Started At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in active_egress_jobs %}
                    <tr>
                        <td><code>{{ job.egress_id[:16] }}...</code></td>
                        <td><strong>{{ job.room_name or '-' }}</strong></td>
                        <td><span class="badge badge-recording">{{ job.status }}</span></td>
                        <td><small>{{ job.started_at }}</small></td>
                        <td>
                            <form method="post" action="/egress/{{ job.egress_id }}/stop" style="display: inline;" onsubmit="return confirm('Stop this active egress worker?');">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-stop-circle"></i> Stop
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endif %}

<!-- Start Manual Egress Modal -->
<div class="modal fade" id="startEgressModal" tabindex="-1" aria-labelledby="startEgressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="startEgressModalLabel">Manual Egress Recording</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="/egress/start">
                <div class="modal-body">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <div class="form-group mb-3">
                        <label class="form-label">Room Name *</label>
                        <input type="text" class="form-control" name="room_name" placeholder="e.g. sip-in-..." required>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Output Filename *</label>
                        <input type="text" class="form-control" name="output_filename" placeholder="manual-{room}-{time}.m4a" required>
                        <small class="text-muted">Saved directly into Cloudflare R2 bucket wasid-voice-recordings</small>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Layout</label>
                        <select class="form-select" name="layout">
                            <option value="grid" selected>Grid</option>
                            <option value="speaker">Speaker</option>
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="audio_only" id="audio_only" checked>
                        <label class="form-check-label" for="audio_only">Audio Only (Optimized for Telephone Calls)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-record-circle"></i> Start Recording</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
